---
import { primaryNav, vaseRock } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top container">
    <div class="footer-intro">
      <p class="eyebrow light">Vase Rock · Xiaoliuqiu</p>
      <h2>下船幾分鐘，<br />看見島嶼的地標。</h2>
      <p>位置、光線、潮位與安全，一次準備好。</p>
      <a
        class="button button-light"
        href={vaseRock.placeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        開啟 Google Maps
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="footer-nav">
      <div>
        <p>行前規劃</p>
        {primaryNav.slice(0, 4).map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div>
        <p>深入了解</p>
        <a href="/best-time/">最佳時間</a>
        <a href="/photo-guide/">拍照指南</a>
        <a href="/snorkeling/">浮潛指南</a>
        <a href="/geology/">地質形成</a>
      </div>
      <div>
        <p>網站資訊</p>
        <a href="/sources/">資料來源</a>
        <a href="/reviews/">遊客評價</a>
        <a href="/image-credits/">圖片版權</a>
        <a href="/faq/">常見問題</a>
        <a href="/privacy-policy/">隱私政策</a>
        <a href="/terms-of-service/">服務條款</a>
        <a href="/cookie-settings/">Cookie 設定</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom container">
    <div class="footer-copyright">
      <p>© {year} 花瓶岩 · 版權所有</p>
      <p>本網站是一個獨立的旅遊資訊項目。我們與任何政府機構或官方組織均無關聯。</p>
    </div>
    <div class="footer-legal-links">
      <a href="/privacy-policy/">隱私政策</a>
      <a href="/terms-of-service/">服務條款</a>
      <a href="/cookie-settings/">Cookie 設定</a>
      <a href="mailto:laupetter72@gmail.com">技術支援：laupetter72@gmail.com</a>
    </div>
  </div>
</footer>

<nav class="mobile-dock" aria-label="手機快速導覽">
  <a href="/map/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s6-5.3 6-11A6 6 0 1 0 6 10c0 5.7 6 11 6 11Z"></path>
      <circle cx="12" cy="10" r="2"></circle>
    </svg>
    地圖
  </a>
  <a href="/tide-guide/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 14c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2"></path>
      <path d="M3 19c2 0 2-2 4-2s2 2 4 2 2-2 4-2 2 2 4 2"></path>
    </svg>
    潮汐
  </a>
  <a href="/from-baisha-port/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m4 18 5-11 3 7 3-9 5 13"></path>
      <path d="M3 18h18"></path>
    </svg>
    交通
  </a>
  <a href="/safety/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3 4 6v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-3Z"></path>
      <path d="m9 12 2 2 4-5"></path>
    </svg>
    安全
  </a>
</nav>
