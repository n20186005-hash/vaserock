---
import { primaryNav, vaseRock } from "@/data/site";
---

<footer class="site-footer">
  <div class="footer-top container">
    <div class="footer-intro">
      <p class="eyebrow light">Vase Rock · Xiaoliuqiu</p>
      <h2>下船幾分鐘，<br />看見島嶼的地標。</h2>
      <p>位置、光線、潮位與安全，一次準備好。</p>
      <a
        class="button button-light"
        href={vaseRock.placeUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        開啟 Google Maps
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="footer-nav">
      <div>
        <p>行前規劃</p>
        {primaryNav.slice(0, 4).map((item) => <a href={item.href}>{item.label}</a>)}
      </div>
      <div>
        <p>深入了解</p>
        <a href="/tide-guide/">潮汐指南</a>
        <a href="/snorkeling/">浮潛指南</a>
        <a href="/geology/">地質形成</a>
        <a href="/faq/">常見問題</a>
      </div>
      <div>
        <p>網站資訊</p>
        <a href="/about/">資料與圖片來源</a>
        <a href="/family-guide/">親子與長輩</a>
        <a href="/itinerary/">行程建議</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom container">
    <p>© {new Date().getFullYear()} VaseRock.com</p>
    <p>交通、潮汐、海況與管制資訊請以現場及主管機關最新公告為準。</p>
    <a href="#top">回到頁首 ↑</a>
  </div>
</footer>

<nav class="mobile-dock" aria-label="手機快速導覽">
  <a href="/map/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 21s6-5.3 6-11A6 6 0 1 0 6 10c0 5.7 6 11 6 11Z"></path>
      <circle cx="12" cy="10" r="2"></circle>
    </svg>
    地圖
  </a>
  <a href="/from-baisha-port/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m4 18 5-11 3 7 3-9 5 13"></path>
      <path d="M3 18h18"></path>
    </svg>
    交通
  </a>
  <a href="/photo-guide/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="6" width="18" height="13" rx="2"></rect>
      <circle cx="12" cy="12.5" r="3.2"></circle>
      <path d="m8 6 1.2-2h5.6L16 6"></path>
    </svg>
    拍照
  </a>
  <a href="/safety/">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 3 4 6v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-3Z"></path>
      <path d="m9 12 2 2 4-5"></path>
    </svg>
    安全
  </a>
</nav>

