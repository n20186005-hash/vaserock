---
import { vaseRock } from "@/data/site";

interface Props {
  variant?: "default" | "compact";
  heading?: string;
}

const {
  variant = "default",
  heading = "Google 地圖使用者評價"
} = Astro.props;

const score = vaseRock.googleRating.score;
const count = vaseRock.googleRating.count;
const syncedAt = vaseRock.googleRating.syncedAt;
const reviewsUrl = vaseRock.googleRating.reviewsUrl;

// 把 4.5 拆成「整數 4 + 半顆星」，生成可视化 SVG 星级
const fullStars = Math.floor(score);
const hasHalf = score - fullStars >= 0.5;
const totalStars = 5;
---

<section
  class={`reviews-block ${variant === "compact" ? "is-compact" : ""}`}
  aria-labelledby="reviews-heading"
>
  <div class="reviews-shell">
    <header class="reviews-head">
      <p class="eyebrow">Google Maps · User Reviews</p>
      <h2 id="reviews-heading">{heading}</h2>
    </header>

    <div class="reviews-summary">
      <div class="reviews-score" aria-label={`Google 地圖評分 ${score} 顆星，共 ${count.toLocaleString()} 則評價`}>
        <strong class="reviews-score-number">{score.toFixed(1)}</strong>
        <div class="reviews-stars" aria-hidden="true">
          {Array.from({ length: totalStars }).map((_, index) => {
            const isFull = index < fullStars;
            const isHalf = !isFull && hasHalf && index === fullStars;
            return (
              <svg viewBox="0 0 20 20" class={isFull ? "is-full" : isHalf ? "is-half" : ""}>
                <defs>
                  <linearGradient id={`half-grad-${index}`} x1="0" x2="1" y1="0" y2="0">
                    <stop offset="50%" stop-color="currentColor" />
                    <stop offset="50%" stop-color="transparent" />
                  </linearGradient>
                </defs>
                <path
                  d="M10 1.6 12.5 7l5.9.6-4.4 4 1.3 5.8L10 14.6 4.7 17.4 6 11.6 1.6 7.6 7.5 7Z"
                  fill={isFull ? "currentColor" : isHalf ? `url(#half-grad-${index})` : "none"}
                  stroke="currentColor"
                  stroke-width="1.2"
                  stroke-linejoin="round"
                />
              </svg>
            );
          })}
        </div>
        <p class="reviews-count">{count.toLocaleString()} 則評價</p>
      </div>

      <div class="reviews-source">
        <p class="reviews-source-title">評分與評價來源</p>
        <p class="reviews-source-body">
          同步自 Google 地圖（Google Maps）使用者評價 · {syncedAt}。
          內容僅於本頁面展示，<strong>未進入 JSON-LD 結構化資料</strong>，
          全部評價、原始評論與最新動態請以 Google 地圖為準。
        </p>
        <p class="reviews-source-meta">
          評分與評價數同步自 Google Maps · {syncedAt} · 點擊查看 Google Maps 全部評價 ↗
        </p>
        <a
          class="reviews-cta"
          href={reviewsUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="google_reviews_open"
        >
          在 Google 地圖查看全部評價
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <p class="reviews-copyright">
      評價與評分版權歸原作者與 Google 地圖所有；本網站僅作引用展示。
    </p>
  </div>
</section>

<style>
  .reviews-block {
    background: var(--ocean-deep);
    color: var(--white);
  }

  .reviews-block.is-compact {
    background: var(--sand);
    color: var(--ocean-ink);
  }

  .reviews-shell {
    width: min(calc(100% - var(--gutter) * 2), var(--container));
    margin-inline: auto;
    padding-block: clamp(78px, 9vw, 132px);
  }

  .reviews-head .eyebrow {
    color: var(--sea-glass);
  }

  .reviews-block.is-compact .reviews-head .eyebrow {
    color: var(--ocean);
  }

  .reviews-head h2 {
    margin: 0;
    font-size: clamp(2rem, 3.7vw, 3.8rem);
    font-weight: 670;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .reviews-summary {
    display: grid;
    margin-top: 48px;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(40px, 6vw, 90px);
  }

  .reviews-score {
    display: grid;
    justify-items: start;
    gap: 14px;
  }

  .reviews-score-number {
    font-size: clamp(4.4rem, 8vw, 7rem);
    font-weight: 620;
    letter-spacing: -0.075em;
    line-height: 1;
  }

  .reviews-block.is-compact .reviews-score-number {
    color: var(--ocean-deep);
  }

  .reviews-stars {
    display: flex;
    color: var(--sea-glass);
    font-size: 0;
    gap: 6px;
  }

  .reviews-block.is-compact .reviews-stars {
    color: var(--warning);
  }

  .reviews-stars svg {
    width: clamp(20px, 2.2vw, 28px);
    height: clamp(20px, 2.2vw, 28px);
    flex: none;
  }

  .reviews-count {
    margin: 4px 0 0;
    color: rgba(255, 255, 255, 0.66);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }

  .reviews-block.is-compact .reviews-count {
    color: var(--muted);
  }

  .reviews-source {
    display: grid;
    gap: 16px;
  }

  .reviews-source-title {
    margin: 0;
    color: var(--sea-glass);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .reviews-block.is-compact .reviews-source-title {
    color: var(--ocean);
  }

  .reviews-source-body,
  .reviews-source-meta,
  .reviews-copyright {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .reviews-block.is-compact .reviews-source-body,
  .reviews-block.is-compact .reviews-source-meta,
  .reviews-block.is-compact .reviews-copyright {
    color: #42585c;
  }

  .reviews-source-meta {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
  }

  .reviews-block.is-compact .reviews-source-meta {
    color: var(--muted);
  }

  .reviews-cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    justify-self: start;
    padding: 14px 22px;
    background: var(--sea-glass);
    color: var(--ocean-ink);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.25s ease;
  }

  .reviews-block.is-compact .reviews-cta {
    background: var(--ocean-deep);
    color: var(--white);
  }

  .reviews-cta:hover {
    transform: translateY(-2px);
  }

  .reviews-cta span {
    font-size: 1.05rem;
  }

  .reviews-copyright {
    margin-top: 36px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.45);
    font-size: 0.78rem;
  }

  .reviews-block.is-compact .reviews-copyright {
    border-color: rgba(18, 59, 74, 0.18);
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .reviews-summary {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .reviews-cta {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>