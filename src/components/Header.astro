---
import { primaryNav, vaseRock } from "@/data/site";

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="Vase Rock 小琉球花瓶岩首頁">
      <svg class="brand-mark" viewBox="0 0 44 44" aria-hidden="true">
        <path d="M8.5 13.5C14 7 30 7 35.5 13.5c-1.3 5-6.1 7.4-8.6 9.7-1.9 1.8-2 6.1-2 10.8h-5.8c0-4.7-.1-9-2-10.8-2.5-2.3-7.3-4.7-8.6-9.7Z"></path>
        <path class="brand-wave" d="M4 35h36"></path>
      </svg>
      <span class="brand-type">
        <strong>VASE ROCK</strong>
        <small>小琉球花瓶岩</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主要導覽">
      {primaryNav.map((item) => (
        <a
          href={item.href}
          aria-current={currentPath.startsWith(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <a
      class="header-cta"
      href={vaseRock.placeUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-track="map_open"
    >
      <span>Google Maps</span>
      <svg viewBox="0 0 20 20" aria-hidden="true">
        <path d="M5 15 15 5M8 5h7v7"></path>
      </svg>
    </a>

    <details class="mobile-menu">
      <summary aria-label="開啟選單">
        <span></span><span></span>
      </summary>
      <div class="mobile-menu-panel">
        <p class="menu-label">探索花瓶岩</p>
        {primaryNav.map((item, index) => (
          <a href={item.href}>
            <span>0{index + 1}</span>
            {item.label}
          </a>
        ))}
        <a class="menu-map" href={vaseRock.placeUrl} target="_blank" rel="noopener noreferrer">
          開始導航
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </details>
  </div>
</header>

