---
import { historyTopics } from "@/data/visitor";
---

<section class="history section container" aria-labelledby="history-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">History & folklore</p>
      <h2 id="history-heading">花瓶岩的歷史背景與在地傳說</h2>
    </div>
    <p class="section-intro">
      把花瓶岩放回時間軸：它是一座仍在變化的島嶼地景，也承載了漁村記憶與口述故事。下列整理以公開文獻與在地共識為據，不杜撰細節。
    </p>
  </div>

  <div class="history-timeline">
    {
      historyTopics.map((topic, index) => (
        <article class={`history-item history-item-${topic.id}`}>
          <div class="history-mark">
            <span>{`0${index + 1}`}</span>
            <span class="history-period">{topic.period ?? "口述"}</span>
          </div>
          <div class="history-body">
            <h3>{topic.title}</h3>
            <p>{topic.content}</p>
          </div>
        </article>
      ))
    }
  </div>
  <p class="history-foot">
    資料參考：《琉球鄉志》、海洋委員會海洋保育署公告、中央地質調查所屏東海岸地質圖資。
  </p>
</section>

<style>
  .history {
    background: var(--foam);
    border-top: 1px solid var(--line);
  }

  .history h2 {
    margin: 0 0 18px;
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    font-weight: 660;
    letter-spacing: -0.04em;
  }

  .history-timeline {
    position: relative;
    margin: 42px 0 0;
    padding-left: 32px;
    border-left: 1px dashed rgba(18, 59, 74, 0.32);
  }

  .history-item {
    position: relative;
    display: grid;
    margin-bottom: 30px;
    grid-template-columns: 160px 1fr;
    gap: 30px;
    align-items: start;
  }

  .history-item:last-child {
    margin-bottom: 0;
  }

  .history-mark {
    position: relative;
    display: grid;
    gap: 6px;
  }

  .history-mark > span:first-child {
    color: var(--ocean);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .history-period {
    color: var(--muted);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
  }

  .history-item::before {
    content: "";
    position: absolute;
    top: 4px;
    left: -38px;
    width: 13px;
    height: 13px;
    border: 3px solid var(--ocean);
    background: var(--white);
    border-radius: 50%;
  }

  .history-body {
    padding: 0 0 6px;
  }

  .history-body h3 {
    margin: 0 0 8px;
    color: var(--ocean-deep);
    font-size: 1.08rem;
    font-weight: 720;
    letter-spacing: -0.02em;
  }

  .history-body p {
    margin: 0;
    color: #42585c;
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .history-foot {
    margin: 30px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 820px) {
    .history-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>