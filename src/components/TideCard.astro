---
import type {
  TidePayload,
  TrendDirection
} from "@/data/tide";
import {
  buildTidePayload,
  formatLevel,
  formatTrend,
  formatLevelLabel,
  formatClock
} from "@/data/tide";

export interface Props {
  initialData?: TidePayload | null;
}

const { initialData = null } = Astro.props as Props;
const data: TidePayload = initialData ?? buildTidePayload();

const trendLabel = formatTrend(data.currentTrend);
const levelLabel = formatLevelLabel(data.advice.level);
const trendEmoji: Record<TrendDirection, string> = {
  rising: "↗",
  falling: "↘",
  high: "◯",
  low: "◯"
};

// 24 小时图表：从当前小时起 24 小时（已经在 hourly[0..24] 范围）
const hourlyWindow = data.hourly.slice(0, 25);
const windowLevels = hourlyWindow.map((h) => h.level);
const minLevel = Math.min(...windowLevels);
const maxLevel = Math.max(...windowLevels);
const span = maxLevel - minLevel || 1;

const nowOffsetHours = Math.max(
  0,
  Math.min(
    hourlyWindow.length - 1,
    (data.nowMs - hourlyWindow[0].time) / 3_600_000
  )
);

const FOUR_EXTREMES = data.upcomingExtremes.slice(0, 4);

const tomorrowHighs = data.tomorrowExtremes.filter((e) => e.type === "high");
const tomorrowLows = data.tomorrowExtremes.filter((e) => e.type === "low");

const updatedAtLabel = (() => {
  const d = new Date(data.generatedAt);
  const localHours = (d.getUTCHours() + 8) % 24;
  const hh = String(localHours).padStart(2, "0");
  const mm = String(d.getUTCMinutes()).padStart(2, "0");
  return `${hh}:${mm}`;
})();

// 图表 SVG 路径
const viewWidth = 1200;
const viewHeight = 220;
const padding = { left: 30, right: 30, top: 30, bottom: 36 };
const chartWidth = viewWidth - padding.left - padding.right;
const chartHeight = viewHeight - padding.top - padding.bottom;

function xFor(index: number): number {
  if (hourlyWindow.length <= 1) return padding.left;
  return padding.left + (index / (hourlyWindow.length - 1)) * chartWidth;
}

function yFor(level: number): number {
  return padding.top + chartHeight - ((level - minLevel) / span) * chartHeight;
}

const linePath = hourlyWindow
  .map((h, i) => `${i === 0 ? "M" : "L"} ${xFor(i).toFixed(1)} ${yFor(h.level).toFixed(1)}`)
  .join(" ");

const fillPath =
  `${linePath} L ${xFor(hourlyWindow.length - 1).toFixed(1)} ${(viewHeight - padding.bottom).toFixed(1)} ` +
  `L ${xFor(0).toFixed(1)} ${(viewHeight - padding.bottom).toFixed(1)} Z`;

// 标注高低潮点
const extremePoints = FOUR_EXTREMES.map((e) => {
  const hourIndex = hourlyWindow.findIndex(
    (h) => Math.abs(h.time - e.time) < 1.8 * 3_600_000
  );
  const useIndex = hourIndex >= 0 ? hourIndex : 0;
  return {
    ...e,
    x: xFor(useIndex),
    y: yFor(e.level)
  };
});
---

<article
  class="tide-card"
  data-tide-card
  aria-labelledby="tide-title"
>
  <header class="tide-heading">
    <div>
      <h2 id="tide-title">花瓶岩潮汐預報</h2>
      <p class="tide-lead">
        基於天文潮調和分析的程式化預報，提供當前潮位、未來 48 小時高低潮時刻、最佳赶海與拍照窗口。
        出海、潛水與商業作業前請以
        <a href={data.source.url} target="_blank" rel="noopener">中央氣象署潮汐預報</a>
        與現場告示牌為準。
      </p>
    </div>
    <div class="tide-meta">
      <span class="tide-meta-label">資料更新</span>
      <strong data-tide-updated>{updatedAtLabel}</strong>
      <span class="tide-meta-hint">每 15 分鐘自動重算</span>
    </div>
  </header>

  <div class="tide-shell">
    {/* 1. 当前状态 */}
    <section class="tide-current" aria-label="當前潮位">
      <div class="tide-current-level">
        <p class="tide-current-label">當前潮位</p>
        <strong class="tide-current-value" data-tide-current-level>
          {formatLevel(data.currentLevelCm)}
        </strong>
        <span class="tide-current-trend" data-tide-current-trend>
          <span class="tide-trend-arrow" data-trend={data.currentTrend}>
            {trendEmoji[data.currentTrend]}
          </span>
          {trendLabel}
        </span>
        <p class="tide-current-headline" data-tide-headline>
          {data.advice.headline}
        </p>
      </div>

      <div class="tide-current-range">
        <div>
          <span>今日最低潮</span>
          <strong data-tide-range-min>{formatLevel(data.rangeCm.min)}</strong>
        </div>
        <div>
          <span>今日最高潮</span>
          <strong data-tide-range-max>{formatLevel(data.rangeCm.max)}</strong>
        </div>
        <div>
          <span>平均海平面</span>
          <strong>{formatLevel(data.meanLevelCm)}</strong>
        </div>
        <div>
          <span>綜合等級</span>
          <strong class={`tide-level-${data.advice.level}`} data-tide-level-label>
            {levelLabel}
          </strong>
        </div>
      </div>
    </section>

    {/* 2. 风险提醒（仅在有警告时显示） */}
    {data.advice.alerts.length > 0 && (
      <ul class="tide-alerts" data-tide-alerts>
        {data.advice.alerts.map((alert) => (
          <li data-severity={alert.severity}>
            <span class="tide-alert-tag">
              {alert.severity === "warning" ? "風險提醒" : alert.severity === "watch" ? "注意" : "提示"}
            </span>
            <div>
              <strong>{alert.title}</strong>
              <p>{alert.text}</p>
            </div>
          </li>
        ))}
      </ul>
    )}

    {/* 3. 24h 潮位曲线 */}
    <section class="tide-chart" aria-labelledby="tide-chart-title">
      <header class="tide-chart-header">
        <h3 id="tide-chart-title">未來 24 小時潮位</h3>
        <div class="tide-chart-legend">
          <span><span class="tide-legend-dot tide-legend-high"></span>高潮</span>
          <span><span class="tide-legend-dot tide-legend-low"></span>低潮</span>
          <span><span class="tide-legend-dot tide-legend-now"></span>現在</span>
        </div>
      </header>

      <svg
        class="tide-chart-svg"
        viewBox={`0 0 ${viewWidth} ${viewHeight}`}
        role="img"
        aria-label="花瓶岩未來 24 小時潮位曲線"
        preserveAspectRatio="none"
      >
        <defs>
          <linearGradient id="tide-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="rgba(23, 121, 138, 0.28)" />
            <stop offset="100%" stop-color="rgba(23, 121, 138, 0)" />
          </linearGradient>
        </defs>

        {/* 网格线 */}
        {[0.25, 0.5, 0.75].map((ratio) => (
          <line
            x1={padding.left}
            x2={padding.left + chartWidth}
            y1={padding.top + chartHeight * ratio}
            y2={padding.top + chartHeight * ratio}
            stroke="rgba(18, 59, 74, 0.08)"
            stroke-dasharray="4 4"
          />
        ))}

        {/* 填充区域 */}
        <path d={fillPath} fill="url(#tide-fill)" />

        {/* 曲线 */}
        <path
          d={linePath}
          fill="none"
          stroke="var(--ocean)"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        {/* 当前时刻竖线 */}
        <line
          x1={xFor(nowOffsetHours)}
          x2={xFor(nowOffsetHours)}
          y1={padding.top}
          y2={padding.top + chartHeight}
          stroke="var(--ocean-deep)"
          stroke-width="2"
          stroke-dasharray="2 3"
        />
        <text
          x={xFor(nowOffsetHours)}
          y={padding.top - 8}
          text-anchor="middle"
          class="tide-chart-now-label"
          fill="var(--ocean-deep)"
        >
          現在
        </text>

        {/* 高潮 / 低潮标注 */}
        {extremePoints.map((point) => (
          <g data-extreme-type={point.type}>
            <circle
              cx={point.x}
              cy={point.y}
              r={point.type === "high" ? 5 : 4}
              fill={point.type === "high" ? "var(--ocean-deep)" : "var(--sand-dark)"}
              stroke="var(--white)"
              stroke-width="2"
            />
            <text
              x={point.x}
              y={point.type === "high" ? point.y - 12 : point.y + 16}
              text-anchor="middle"
              class={`tide-chart-extreme-label tide-chart-extreme-${point.type}`}
              fill={point.type === "high" ? "var(--ocean-deep)" : "var(--rock)"}
            >
              {point.type === "high" ? "高" : "低"} {point.clock}
            </text>
          </g>
        ))}

        {/* X 轴时间刻度（每 3 小时一个） */}
        {hourlyWindow.filter((_, i) => i % 3 === 0 || i === hourlyWindow.length - 1).map((h) => {
          const idx = hourlyWindow.indexOf(h);
          return (
            <text
              x={xFor(idx)}
              y={viewHeight - 12}
              text-anchor="middle"
              class="tide-chart-tick"
              fill="var(--muted)"
            >
              {h.clock}
            </text>
          );
        })}

        {/* Y 轴范围 */}
        <text x={padding.left} y={padding.top - 12} class="tide-chart-tick" fill="var(--muted)">
          {`${Math.round(maxLevel)}`}cm
        </text>
        <text
          x={padding.left}
          y={padding.top + chartHeight + 4}
          class="tide-chart-tick"
          fill="var(--muted)"
        >
          {`${Math.round(minLevel)}`}cm
        </text>
      </svg>
    </section>

    {/* 4. 三块标签：赶海 / 拍照 / 下水 */}
    <section class="tide-advice" aria-label="潮汐建議">
      {data.advice.beach.length > 0 && (
        <article class="tide-advice-block">
          <header>
            <span class="tide-advice-mark" aria-hidden="true">🦀</span>
            <strong>趕海與觀察潮間帶</strong>
          </header>
          <ul>
            {data.advice.beach.map((text) => <li>{text}</li>)}
          </ul>
        </article>
      )}
      {data.advice.photo.length > 0 && (
        <article class="tide-advice-block">
          <header>
            <span class="tide-advice-mark" aria-hidden="true">📷</span>
            <strong>拍照建議</strong>
          </header>
          <ul>
            {data.advice.photo.map((text) => <li>{text}</li>)}
          </ul>
        </article>
      )}
      {data.advice.water.length > 0 && (
        <article class="tide-advice-block">
          <header>
            <span class="tide-advice-mark" aria-hidden="true">🌊</span>
            <strong>下水與浮潛</strong>
          </header>
          <ul>
            {data.advice.water.map((text) => <li>{text}</li>)}
          </ul>
        </article>
      )}
    </section>

    {/* 5. 接下来 4 个高低潮 */}
    <section class="tide-card-grid" aria-label="接下來 4 次高低潮">
      <header class="tide-card-grid-header">
        <h3>接下來 4 次高低潮</h3>
        <span>時間為當地時鐘，潮位為相對當地潮位零點的公分數</span>
      </header>
      <ol class="tide-card-list">
        {FOUR_EXTREMES.map((e) => (
          <li data-extreme-type={e.type}>
            <span class="tide-card-type">{e.type === "high" ? "高潮" : "低潮"}</span>
            <strong class="tide-card-clock">{e.clock}</strong>
            <span class="tide-card-date">{e.date}</span>
            <span class="tide-card-level">{formatLevel(e.level)}</span>
          </li>
        ))}
      </ol>
    </section>

    {/* 6. 明日高潮/低潮 + 最佳窗口 */}
    <section class="tide-tomorrow" aria-label="明日潮汐預報">
      <header class="tide-tomorrow-header">
        <h3>明日潮汐摘要</h3>
        <span data-tide-tomorrow-date>當地時區</span>
      </header>
      <div class="tide-tomorrow-grid">
        {tomorrowHighs.length > 0 && tomorrowHighs.slice(0, 2).map((e) => (
          <div class="tide-tomorrow-block tide-tomorrow-high">
            <span>高潮</span>
            <strong>{e.clock}</strong>
            <em>{formatLevel(e.level)}</em>
          </div>
        ))}
        {tomorrowLows.length > 0 && tomorrowLows.slice(0, 2).map((e) => (
          <div class="tide-tomorrow-block tide-tomorrow-low">
            <span>低潮</span>
            <strong>{e.clock}</strong>
            <em>{formatLevel(e.level)}</em>
          </div>
        ))}
      </div>

      {data.bestBeachWindow && (
        <p class="tide-window-note">
          <span class="tide-window-tag tide-window-beach">最佳趕海窗口</span>
          {`最低潮 ${formatClock(data.bestBeachWindow.startMs + 2 * 3_600_000)}（${formatLevel(data.bestBeachWindow.level)}），前後各 2 小時適合觀察潮間帶。`}
        </p>
      )}
      {data.bestPhotoWindow && (
        <p class="tide-window-note">
          <span class="tide-window-tag tide-window-photo">拍照黃金時段</span>
          {`最高潮 ${formatClock(data.bestPhotoWindow.startMs + 1.5 * 3_600_000)}（${formatLevel(data.bestPhotoWindow.level)}），前後 1.5 小時海水包圍岩體最完整。`}
        </p>
      )}
    </section>

    {/* 7. 珊瑚礁护育 */}
    {data.advice.conservation.length > 0 && (
      <section class="tide-conservation">
        <header>
          <span class="tide-advice-mark" aria-hidden="true">🐢</span>
          <strong>花瓶岩珊瑚礁護育提醒</strong>
        </header>
        <ul>
          {data.advice.conservation.map((text) => <li>{text}</li>)}
        </ul>
      </section>
    )}

    <footer class="tide-footer">
      <p>{data.datumNote}</p>
      <p>
        預報來源：
        <a href={data.source.url} target="_blank" rel="noopener" data-tide-source>
          {data.source.name}
        </a>
      </p>
    </footer>
  </div>

  <div class="tide-actions">
    <button type="button" class="tide-refresh" data-tide-refresh>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path d="M3 8a5 5 0 0 1 9-3M13 8a5 5 0 0 1-9 3" />
        <path d="M11 1v4h-4M5 15v-4h4" />
      </svg>
      重新計算
    </button>
    <a class="tide-more" href="/tide-guide/">
      查看完整潮汐指南
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<script>
  import type { TidePayload } from "@/data/tide";
  import {
    buildTidePayload,
    formatLevel,
    formatTrend,
    formatLevelLabel
  } from "@/data/tide";

  const cards = document.querySelectorAll<HTMLElement>("[data-tide-card]");

  cards.forEach((card) => {
    const refreshBtn = card.querySelector<HTMLButtonElement>("[data-tide-refresh]");
    const updatedEl = card.querySelector<HTMLElement>("[data-tide-updated]");

    const setText = (selector: string, value: string) => {
      const el = card.querySelector(selector);
      if (el) el.textContent = value;
    };

    const apply = (next: TidePayload) => {
      const trendLabel = formatTrend(next.currentTrend);
      const levelLabel = formatLevelLabel(next.advice.level);

      setText("[data-tide-current-level]", formatLevel(next.currentLevelCm));
      const trendEl = card.querySelector("[data-tide-current-trend]");
      if (trendEl) {
        const arrowEl = trendEl.querySelector("[data-trend]") as HTMLElement | null;
        if (arrowEl) {
          arrowEl.dataset.trend = next.currentTrend;
          const arrows: Record<string, string> = {
            rising: "↗",
            falling: "↘",
            high: "◯",
            low: "◯"
          };
          arrowEl.textContent = arrows[next.currentTrend] ?? "↗";
        }
        // 保留箭头，重写文字
        const arrowText = arrowEl?.outerHTML ?? "";
        trendEl.innerHTML = `${arrowText} ${trendLabel}`;
      }
      setText("[data-tide-headline]", next.advice.headline);
      setText("[data-tide-range-min]", formatLevel(next.rangeCm.min));
      setText("[data-tide-range-max]", formatLevel(next.rangeCm.max));
      const levelLabelEl = card.querySelector("[data-tide-level-label]");
      if (levelLabelEl) {
        levelLabelEl.textContent = levelLabel;
        levelLabelEl.className = `tide-level-${next.advice.level}`;
      }

      if (updatedEl) {
        const now = new Date(next.generatedAt);
        const utcHours = now.getUTCHours();
        const localHours = (utcHours + 8) % 24;
        const hh = String(localHours).padStart(2, "0");
        const mm = String(now.getUTCMinutes()).padStart(2, "0");
        updatedEl.textContent = `${hh}:${mm}`;
      }

      // 简单重置即可——重新计算后整张卡片由 SSR 重渲染
      // 这里直接 reload 页面片段以保证 SVG/曲线一致
      window.location.reload();
    };

    refreshBtn?.addEventListener("click", () => {
      const next = buildTidePayload();
      apply(next);
    });
  });
</script>

<style is:global>
  .tide-section {
    padding-block: clamp(78px, 9vw, 132px);
    border-top: 1px solid var(--line);
    background:
      radial-gradient(circle at 8% 88%, rgba(114, 184, 177, 0.18), transparent 31rem),
      var(--foam);
  }

  .tide-card {
    width: 100%;
  }

  .tide-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 40px;
    margin-bottom: 36px;
  }

  .tide-heading > div {
    max-width: 760px;
  }

  .tide-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.7vw, 3.8rem);
    font-weight: 670;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .tide-lead {
    max-width: 660px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .tide-lead a,
  .tide-footer a {
    color: var(--ocean);
    font-weight: 800;
  }

  .tide-meta {
    flex: none;
    text-align: right;
  }

  .tide-meta-label {
    display: block;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .tide-meta strong {
    display: block;
    margin: 4px 0 0;
    color: var(--ocean-deep);
    font-size: 1.4rem;
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  .tide-meta-hint {
    display: block;
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.72rem;
  }

  .tide-shell {
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 28px 70px rgba(8, 44, 54, 0.1);
  }

  /* ---------- 当前状态 ---------- */
  .tide-current {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 0;
    border-bottom: 1px solid var(--line);
  }

  .tide-current-level {
    padding: 30px 32px;
    background:
      linear-gradient(135deg, rgba(23, 121, 138, 0.08), rgba(114, 184, 177, 0.02));
  }

  .tide-current-label {
    margin: 0;
    color: var(--muted);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .tide-current-value {
    display: block;
    margin: 6px 0 4px;
    color: var(--ocean-deep);
    font-size: clamp(3.1rem, 6vw, 4.7rem);
    font-weight: 680;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .tide-current-trend {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 12px;
    background: var(--ocean-deep);
    color: var(--sea-glass);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .tide-trend-arrow {
    display: inline-block;
    width: 16px;
    text-align: center;
    font-weight: 900;
  }

  [data-trend="rising"] {
    color: var(--sea-glass);
  }

  [data-trend="falling"] {
    color: var(--sea-glass);
  }

  [data-trend="high"] {
    color: var(--warning-soft);
  }

  [data-trend="low"] {
    color: var(--white);
  }

  .tide-current-headline {
    max-width: 360px;
    margin: 14px 0 0;
    color: #2b3d44;
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .tide-current-range {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: center;
    padding: 18px 32px;
  }

  .tide-current-range > div {
    padding: 12px 16px;
    border-top: 1px solid rgba(18, 59, 74, 0.08);
    border-left: 1px solid rgba(18, 59, 74, 0.08);
  }

  .tide-current-range > div:nth-child(2n + 1) {
    border-left: 0;
  }

  .tide-current-range > div:nth-child(-n + 2) {
    border-top: 0;
  }

  .tide-current-range span {
    color: var(--muted);
    font-size: 0.7rem;
  }

  .tide-current-range strong {
    display: block;
    margin-top: 3px;
    color: var(--ocean-deep);
    font-size: 1rem;
    font-weight: 750;
  }

  .tide-level-good {
    color: var(--ocean) !important;
  }

  .tide-level-watch {
    color: var(--warning) !important;
  }

  .tide-level-avoid {
