---
import { visitorServices } from "@/data/visitor";

const iconPaths: Record<string, string> = {
  wc: "M9 4v6h6V4h2v6h2v3h-3v9h-2v-9h-4v9H8v-9H5v-3h2V4z",
  parking: "M9 3h4a4 4 0 0 1 0 8h-2v10H7V3zm2 6h2a2 2 0 0 0 0-4h-2z",
  dining: "M5 3v8a3 3 0 0 0 3 3v7h2v-7a3 3 0 0 0 3-3V3h-2v8h-2V3h-2v8H7V3zm12 0c-2 0-3 2-3 5v6h2v-9h1v18h2V8c0-3-1-5-2-5z",
  lodging: "M3 12V8a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v4h-2V8a1 1 0 0 0-1-1h-3v4H9V7H6a1 1 0 0 0-1 1v4zm2 9v-6h14v6h-2v-4h-2v4h-2v-4h-2v4H9v-4H7v4z",
  grocery: "M5 4h14l-1 4H6zm0 6h14l-1 9H6zm3 3v3h2v-3zm6 0v3h2v-3z",
  fuel: "M5 3h10v18H5zm3 4h4v4H8zm6-1h2a3 3 0 0 1 3 3v6a2 2 0 0 1-4 0v-3h2v3m0-9v3"
};
---

<section class="services section container" aria-labelledby="services-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Visitor services</p>
      <h2 id="services-heading">花瓶岩周邊訪客服務與設施類型</h2>
    </div>
    <p class="section-intro">
      以類型整理小琉球常見的訪客設施與分布區位，不推薦具體商家名稱；實際資訊請依當地最新公告與 Google 地圖評評為準。
    </p>
  </div>

  <div class="services-grid">
    {
      visitorServices.map((service, index) => (
        <article class="service-card" data-service={service.id}>
          <header>
            <span class="service-index">{`0${index + 1}`}</span>
            <span class="service-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d={iconPaths[service.icon] ?? "M4 12h16v8H4z"} />
              </svg>
            </span>
          </header>
          <div>
            <h3>{service.category}</h3>
            <span class="service-en">{service.categoryEn}</span>
            <p>{service.summary}</p>
          </div>
          <dl>
            <dt>常見位置</dt>
            <dd>{service.locations}</dd>
            <dt>使用建議</dt>
            <dd>{service.notes}</dd>
          </dl>
        </article>
      ))
    }
  </div>

  <p class="services-note">
    本網站為非營利科普性質，僅彙整類型與位置資訊；不為任何個別商家背書，亦不收取任何推廣費用。
  </p>
</section>

<style>
  .services {
    background: var(--sand);
    border-top: 1px solid var(--line);
  }

  .services h2 {
    margin: 0 0 18px;
    font-size: clamp(1.6rem, 2.4vw, 2.4rem);
    font-weight: 660;
    letter-spacing: -0.04em;
  }

  .services-grid {
    display: grid;
    margin-top: 42px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .service-card {
    display: grid;
    padding: 26px 24px;
    border: 1px solid var(--line);
    background: var(--white);
    grid-template-rows: auto 1fr auto;
    gap: 18px;
  }

  .service-card header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .service-index {
    color: var(--ocean);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .service-icon {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    background: var(--ocean-deep);
    color: var(--sea-glass);
  }

  .service-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .service-card h3 {
    margin: 0;
    color: var(--ocean-deep);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .service-en {
    display: block;
    margin: 4px 0 12px;
    color: var(--muted);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .service-card p {
    margin: 0;
    color: #42585c;
    font-size: 0.88rem;
    line-height: 1.75;
  }

  .service-card dl {
    margin: 0;
    padding-top: 14px;
    border-top: 1px dashed rgba(18, 59, 74, 0.18);
  }

  .service-card dt {
    color: var(--ocean);
    font-size: 0.66rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .service-card dd {
    margin: 4px 0 12px;
    color: #42585c;
    font-size: 0.84rem;
    line-height: 1.7;
  }

  .service-card dd:last-child {
    margin-bottom: 0;
  }

  .services-note {
    margin: 28px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 1080px) {
    .services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }
</style>