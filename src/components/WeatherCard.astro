---
import type { WeatherPayload } from "@/data/weather";
import { formatTimeOnly, formatUpdatedAt, uvIndexLabel, windDirectionLabel } from "@/data/weather";

export interface Props {
  initialData?: WeatherPayload | null;
}

const { initialData = null } = Astro.props as Props;
const hasData = initialData !== null;

const current = initialData?.current;
const today = initialData?.today;
const advice = initialData?.advice;
const sunrise = initialData?.sunrise;
const sunset = initialData?.sunset;
---

<article
  class="weather-card"
  data-weather-card
  aria-labelledby="weather-title"
  aria-busy={hasData ? "false" : "true"}
>
  <header class="weather-heading">
    <div>
      <h2 id="weather-title">花瓶岩即時天氣與七日預報</h2>
      <p class="weather-lead">
        自動查詢花瓶岩周邊，提供目前溫濕度、風力、紫外線，以及未來七日的最高／最低溫、降雨機率。建議依現場潮位、浪況與告示牌優先判斷。
      </p>
    </div>
    <p class="weather-updated" data-weather-updated aria-live="polite">
      {hasData ? `更新於 ${formatUpdatedAt(initialData!.updatedAt)}` : "正在取得最新資料…"}
    </p>
  </header>

  <div class="weather-shell">
    {
      !hasData && (
        <div class="weather-loading" data-weather-loading>
          <span class="weather-loading-icon" aria-hidden="true" />
          <div>
            <strong>天氣資料載入中</strong>
            <p>正在取得花瓶岩周邊的最新觀測…</p>
          </div>
        </div>
      )
    }

    {
      hasData && (
        <div class="weather-content" data-weather-content>
          {/* 1. 当前概况：温度 + 体感 + 概况 */}
          <div class="weather-current">
            <div class="weather-current-main">
              <span class="weather-icon" aria-hidden="true" data-weather-icon>
                {current!.icon}
              </span>
              <div>
                <p class="weather-condition" data-weather-condition>
                  {`${current!.isDay ? "日間" : "夜間"} · ${current!.condition}`}
                </p>
                <div class="weather-temperature">
                  <strong data-weather-temperature>
                    {`${Math.round(current!.temperature)}°`}
                  </strong>
                  <div class="weather-temperature-detail">
                    <span>體感 <b data-weather-apparent>
                      {`${Math.round(current!.apparentTemperature)}°`}
                    </b></span>
                    <span>濕度 <b data-weather-humidity>
                      {`${Math.round(current!.humidity)}%`}
                    </b></span>
                    <span>風向 <b data-wind-direction-text>
                      {`${windDirectionLabel(current!.windDirection)}`}
                    </b> 風速 <b data-wind-speed-text>
                      {`${Math.round(current!.windSpeed)} km/h`}
                    </b></span>
                  </div>
                </div>
              </div>
            </div>

            <div class="weather-headline" data-weather-headline>
              <strong>{advice!.headline}</strong>
            </div>
          </div>

          {/* 2. 风险提醒（置顶，仅当有警告时显示） */}
          {advice!.alerts.length > 0 && (
            <ul class="weather-alerts" data-weather-alerts>
              {advice!.alerts.map((alert) => (
                <li data-severity={alert.severity}>
                  <span class="weather-alert-tag">{alert.severity === "warning" ? "風險提醒" : alert.severity === "watch" ? "注意" : "提示"}</span>
                  <div>
                    <strong>{alert.title}</strong>
                    <p>{alert.text}</p>
                  </div>
                </li>
              ))}
            </ul>
          )}

          {/* 3. 三块标签：穿搭 / 游玩 / 随身 */}
          <div class="weather-advice-grid" data-weather-advice>
            {advice!.dress.length > 0 && (
              <article class="weather-advice-block">
                <header>
                  <span class="weather-advice-mark">👕</span>
                  <strong>出行穿搭</strong>
                </header>
                <ul>
                  {advice!.dress.map((text) => <li>{text}</li>)}
                </ul>
              </article>
            )}
            {advice!.plan.length > 0 && (
              <article class="weather-advice-block">
                <header>
                  <span class="weather-advice-mark">🗺️</span>
                  <strong>遊玩安排</strong>
                </header>
                <ul>
                  {advice!.plan.map((text) => <li>{text}</li>)}
                </ul>
              </article>
            )}
            {advice!.gear.length > 0 && (
              <article class="weather-advice-block">
                <header>
                  <span class="weather-advice-mark">🎒</span>
                  <strong>隨身物品</strong>
                </header>
                <ul>
                  {advice!.gear.map((text) => <li>{text}</li>)}
                </ul>
              </article>
            )}
          </div>

          {/* 4. 海边专属 */}
          {advice!.coastal.length > 0 && (
            <section class="weather-coastal">
              <header>
                <span class="weather-advice-mark">🌊</span>
                <strong>花瓶岩海岸提示</strong>
              </header>
              <ul>
                {advice!.coastal.map((text) => <li>{text}</li>)}
              </ul>
            </section>
          )}

          {/* 5. 七日预报（横向滚动） */}
          <section class="weather-week" aria-labelledby="weather-week-title">
            <header>
              <h3 id="weather-week-title">未來七日預報</h3>
              <span>日出 <b data-weather-sunrise>{formatTimeOnly(sunrise!)}</b> ／ 日落 <b data-weather-sunset>{formatTimeOnly(sunset!)}</b></span>
            </header>
            <ol class="weather-week-list" data-weather-days>
              {initialData!.daily.map((day, index) => (
                <li data-day-index={index} class={index === 0 ? "weather-week-today" : ""}>
                  <strong>{day.label}</strong>
                  <span class="weather-week-icon" aria-hidden="true">{day.icon}</span>
                  <span class="weather-week-condition">{day.condition}</span>
                  <span class="weather-week-temp">{`${Math.round(day.maxTemperature)}°／${Math.round(day.minTemperature)}°`}</span>
                  <span class="weather-week-rain">
                    <svg viewBox="0 0 16 16" aria-hidden="true">
                      <path d="M8 2a5 5 0 0 1 5 5c0 3-2 6-5 6s-5-3-5-6a5 5 0 0 1 5-5z" />
                    </svg>
                    {`${Math.round(day.precipitationProbability)}%`}
                  </span>
                  <span class="weather-week-uv">
                    UV <b>{`${day.uvIndexMax.toFixed(1)}`}</b>
                    <em>{uvIndexLabel(day.uvIndexMax).label}</em>
                  </span>
                  <span class="weather-week-wind">
                    {`${Math.round(day.maxWindGust)} km/h`}
                  </span>
                </li>
              ))}
            </ol>
          </section>

          {/* 6. 今日快指标 */}
          <dl class="weather-metrics">
            <div>
              <dt>今日高／低</dt>
              <dd data-weather-range>
                {`${Math.round(today!.maxTemperature)}°／${Math.round(today!.minTemperature)}°`}
              </dd>
            </div>
            <div>
              <dt>今日降雨機率</dt>
              <dd data-weather-rain>
                {`${Math.round(today!.precipitationProbability)}%`}
              </dd>
            </div>
            <div>
              <dt>今日 UV 指數</dt>
              <dd data-weather-uv>
                {`${today!.uvIndexMax.toFixed(1)}（${uvIndexLabel(today!.uvIndexMax).label}）`}
              </dd>
            </div>
            <div>
              <dt>累計降雨量</dt>
              <dd data-weather-rain-sum>
                {`${today!.precipitationSum.toFixed(1)} mm`}
              </dd>
            </div>
            <div>
              <dt>最大陣風</dt>
              <dd data-weather-gust>
                {`${Math.round(today!.maxWindGust)} km/h`}
              </dd>
            </div>
            <div>
              <dt>日出／日落</dt>
              <dd data-weather-sun>
                {`${formatTimeOnly(sunrise!)} ／ ${formatTimeOnly(sunset!)}`}
              </dd>
            </div>
          </dl>

          <footer class="weather-footer">
            <p>天氣預報不含即時海浪與潮位，請以現場告示牌與中央氣象署即時資料為準。</p>
            <p>
              氣象資料來源：
              <a href={initialData!.source.url} target="_blank" rel="noopener" data-weather-source>
                {initialData!.source.name}
              </a>
            </p>
          </footer>
        </div>
      )
    }

    <div class="weather-error" data-weather-error hidden>
      <span aria-hidden="true">
        <svg viewBox="0 0 32 32">
          <path d="M3 18c4-5 7 5 11 0s7 5 11 0 4 0 4 0"></path>
          <path d="M3 12c4-5 7 5 11 0s7 5 11 0 4 0 4 0"></path>
        </svg>
      </span>
      <div>
        <strong>暫時無法取得天氣資料</strong>
        <p>
          請稍後再試，或直接查看
          <a href="https://www.cwa.gov.tw/" target="_blank" rel="noopener">中央氣象署</a>。
        </p>
      </div>
    </div>
  </div>

  <a class="weather-more" href="/best-time/">
    查看最佳時間與潮汐建議
    <span aria-hidden="true">→</span>
  </a>
</article>

<script>
  import type { WeatherPayload } from "@/data/weather";
  import {
    describeWeather,
    formatTimeOnly,
    formatUpdatedAt,
    uvIndexLabel,
    windDirectionLabel
  } from "@/data/weather";

  const cards = document.querySelectorAll<HTMLElement>("[data-weather-card]");

  cards.forEach((card) => {
    const loading = card.querySelector<HTMLElement>("[data-weather-loading]");
    const error = card.querySelector<HTMLElement>("[data-weather-error]");
    const content = card.querySelector<HTMLElement>("[data-weather-content]");

    const setText = (selector: string, value: string) => {
      const element = card.querySelector(selector);
      if (element) element.textContent = value;
    };

    const escapeHtml = (input: string) =>
      input.replace(/[&<>"']/g, (char) =>
        char === "&" ? "&amp;" :
        char === "<" ? "&lt;" :
        char === ">" ? "&gt;" :
        char === '"' ? "&quot;" : "&#39;"
      );

    const apply = (weather: WeatherPayload) => {
      const [condition, icon] = describeWeather(
        weather.current.weatherCode,
        weather.current.isDay
      );

      setText("[data-weather-icon]", weather.current.icon || icon);
      setText("[data-weather-temperature]", `${Math.round(weather.current.temperature)}°`);
      setText(
        "[data-weather-condition]",
        `${weather.current.isDay ? "日間" : "夜間"} · ${weather.current.condition || condition}`
      );
      setText("[data-weather-apparent]", `${Math.round(weather.current.apparentTemperature)}°`);
      setText("[data-weather-humidity]", `${Math.round(weather.current.humidity)}%`);
      setText(
        "[data-wind-direction-text]",
        `${windDirectionLabel(weather.current.windDirection)}`
      );
      setText("[data-wind-speed-text]", `${Math.round(weather.current.windSpeed)} km/h`);
      setText("[data-weather-headline]", weather.advice.headline);

      setText(
        "[data-weather-range]",
        `${Math.round(weather.today.maxTemperature)}°／${Math.round(weather.today.minTemperature)}°`
      );
      setText(
        "[data-weather-rain]",
        `${Math.round(weather.today.precipitationProbability)}%`
      );
      setText(
        "[data-weather-uv]",
        `${weather.today.uvIndexMax.toFixed(1)}（${uvIndexLabel(weather.today.uvIndexMax).label}）`
      );
      setText(
        "[data-weather-rain-sum]",
        `${weather.today.precipitationSum.toFixed(1)} mm`
      );
      setText(
        "[data-weather-gust]",
        `${Math.round(weather.today.maxWindGust)} km/h`
      );
      setText(
        "[data-weather-sun]",
        `${formatTimeOnly(weather.sunrise)} ／ ${formatTimeOnly(weather.sunset)}`
      );
      setText("[data-weather-sunrise]", formatTimeOnly(weather.sunrise));
      setText("[data-weather-sunset]", formatTimeOnly(weather.sunset));

      setText("[data-weather-updated]", `更新於 ${formatUpdatedAt(weather.updatedAt)}`);

      const source = card.querySelector("[data-weather-source]");
      if (source instanceof HTMLAnchorElement) {
        source.textContent = weather.source.name;
        source.href = weather.source.url;
      }

      // 风险提醒
      const alertsContainer = card.querySelector("[data-weather-alerts]");
      if (alertsContainer instanceof HTMLUListElement) {
        if (weather.advice.alerts.length > 0) {
          alertsContainer.replaceChildren(
            ...weather.advice.alerts.map((alert) => {
              const item = document.createElement("li");
              item.dataset.severity = alert.severity;
              const tag = document.createElement("span");
              tag.className = "weather-alert-tag";
              tag.textContent =
                alert.severity === "warning"
                  ? "風險提醒"
                  : alert.severity === "watch"
                  ? "注意"
                  : "提示";
              const wrap = document.createElement("div");
              const title = document.createElement("strong");
              const text = document.createElement("p");
              title.textContent = alert.title;
              text.textContent = alert.text;
              wrap.append(title, text);
              item.append(tag, wrap);
              return item;
            })
          );
          alertsContainer.hidden = false;
        } else {
          alertsContainer.replaceChildren();
          alertsContainer.hidden = true;
        }
      }

      // 三块建议
      const adviceContainer = card.querySelector("[data-weather-advice]");
      if (adviceContainer instanceof HTMLElement) {
        const blocks: Array<{ title: string; icon: string; lines: string[] }> = [
          { title: "出行穿搭", icon: "👕", lines: weather.advice.dress },
          { title: "遊玩安排", icon: "🗺️", lines: weather.advice.plan },
          { title: "隨身物品", icon: "🎒", lines: weather.advice.gear }
        ];
        adviceContainer.replaceChildren(
          ...blocks
            .filter((block) => block.lines.length > 0)
            .map((block) => {
              const article = document.createElement("article");
              article.className = "weather-advice-block";
              const header = document.createElement("header");
              const mark = document.createElement("span");
              mark.className = "weather-advice-mark";
              mark.textContent = block.icon;
              const strong = document.createElement("strong");
              strong.textContent = block.title;
              header.append(mark, strong);
              const ul = document.createElement("ul");
              ul.append(
                ...block.lines.map((line) => {
                  const li = document.createElement("li");
                  li.textContent = line;
                  return li;
                })
              );
              article.append(header, ul);
              return article;
            })
        );
      }

      // 海岸
      const coastal = card.querySelector(".weather-coastal");
      if (coastal instanceof HTMLElement) {
        if (weather.advice.coastal.length > 0) {
          coastal.replaceChildren(
            (() => {
              const header = document.createElement("header");
              const mark = document.createElement("span");
              mark.className = "weather-advice-mark";
              mark.textContent = "🌊";
              const strong = document.createElement("strong");
              strong.textContent = "花瓶岩海岸提示";
              header.append(mark, strong);
              const ul = document.createElement("ul");
              ul.append(
                ...weather.advice.coastal.map((line) => {
                  const li = document.createElement("li");
                  li.textContent = line;
                  return li;
                })
              );
              const frag = document.createDocumentFragment();
              frag.append(header, ul);
              return frag;
            })()
          );
          coastal.hidden = false;
        } else {
          coastal.replaceChildren();
          coastal.hidden = true;
        }
      }

      // 七日预报
      const days = card.querySelector("[data-weather-days]");
      if (days instanceof HTMLOListElement) {
        days.replaceChildren(
          ...weather.daily.map((day, index) => {
            const item = document.createElement("li");
            item.dataset.dayIndex = String(index);
            if (index === 0) item.classList.add("weather-week-today");
            const label = document.createElement("strong");
            label.textContent = day.label;
            const icon = document.createElement("span");
            icon.className = "weather-week-icon";
            icon.setAttribute("aria-hidden", "true");
            icon.textContent = day.icon;
            const condition = document.createElement("span");
            condition.className = "weather-week-condition";
            condition.textContent = day.condition;
            const temp = document.createElement("span");
            temp.className = "weather-week-temp";
            temp.textContent =
              `${Math.round(day.maxTemperature)}°／${Math.round(day.minTemperature)}°`;
            const rain = document.createElement("span");
            rain.className = "weather-week-rain";
            rain.innerHTML = `
              <svg viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 2a5 5 0 0 1 5 5c0 3-2 6-5 6s-5-3-5-6a5 5 0 0 1 5-5z"></path>
              </svg>${escapeHtml(`${Math.round(day.precipitationProbability)}%`)}
            `;
            const uv = document.createElement("span");
            uv.className = "weather-week-uv";
            const uvLabel = uvIndexLabel(day.uvIndexMax).label;
            uv.innerHTML = `UV <b>${escapeHtml(day.uvIndexMax.toFixed(1))}</b><em>${escapeHtml(uvLabel)}</em>`;
            const wind = document.createElement("span");
            wind.className = "weather-week-wind";
            wind.textContent = `${Math.round(day.maxWindGust)} km/h`;
            item.append(label, icon, condition, temp, rain, uv, wind);
            return item;
          })
        );
      }

      if (loading) loading.hidden = true;
      if (error) error.hidden = true;
      if (content) content.hidden = false;
      card.setAttribute("aria-busy", "false");
    };

    fetch("/api/weather", { headers: { Accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error("Weather request failed");
        return response.json() as Promise<WeatherPayload>;
      })
      .then(apply)
      .catch(() => {
        if (loading) loading.hidden = true;
        if (content && !content.hasAttribute("data-weather-initial")) content.hidden = true;
        if (error) error.hidden = false;
        setText("[data-weather-updated]", "資料暫時無法取得");
        card.setAttribute("aria-busy", "false");
      });
  });
</script>

<style is:global>
  .weather-section {
    padding-block: clamp(78px, 9vw, 132px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 92% 12%, rgba(114, 184, 177, 0.18), transparent 31rem),
      var(--foam);
  }

  .weather-card {
    width: 100%;
  }

  .weather-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 36px;
  }

  .weather-heading > div {
    max-width: 760px;
  }

  .weather-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.7vw, 3.8rem);
    font-weight: 670;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .weather-lead {
    max-width: 640px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .weather-updated {
    flex: none;
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .weather-shell {
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 28px 70px rgba(8, 44, 54, 0.1);
  }

  .weather-loading,
  .weather-error {
    display: flex;
    min-height: 220px;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px;
    color: var(--muted);
  }

  .weather-loading[hidden],
  .weather-error[hidden],
  .weather-content[hidden],
  .weather-alerts[hidden],
  .weather-coastal[hidden] {
    display: none;
  }

  .weather-loading strong,
  .weather-error strong {
    color: var(--ocean-deep);
    font-size: 0.95rem;
  }

  .weather-loading p,
  .weather-error p {
    margin: 3px 0 0;
    font-size: 0.8rem;
  }

  .weather-error > span {
    display: grid;
    width: 48px;
    height: 48px;
    flex: none;
    place-items: center;
    background: var(--warning-soft);
    color: var(--warning);
  }

  .weather-error svg {
    width: 27px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  .weather-error a,
  .weather-footer a {
    color: var(--ocean);
    font-weight: 800;
  }

  .weather-loading-icon {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(23, 121, 138, 0.14);
    border-top-color: var(--ocean);
    border-radius: 50%;
    animation: weather-spin 0.9s linear infinite;
  }

  @keyframes weather-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* ---------- 当前概况 ---------- */
  .weather-current {
    display: grid;
    padding: 30px 32px 22px;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 24px;
  }

  .weather-current-main {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .weather-icon {
    font-size: clamp(3.7rem, 7vw, 5.4rem);
    line-height: 1;
    filter: drop-shadow(0 7px 12px rgba(8, 44, 54, 0.12));
  }

  .weather-condition {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .weather-temperature {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px 22px;
  }

  .weather-temperature > strong {
    color: var(--ocean-deep);
    font-size: clamp(3.1rem, 6vw, 4.7rem);
    font-weight: 680;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .weather-temperature-detail {
    display: grid;
    gap: 2px;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .weather-temperature-detail b {
    color: var(--ocean-deep);
    font-weight: 700;
  }

  .weather-headline {
    align-self: flex-start;
    padding: 10px 16px;
    border: 1px solid var(--line);
    background: var(--ocean-deep);
    color: var(--sea-glass);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .weather-headline strong {
    color: var(--white);
  }

  /* ---------- 风险提醒（置顶） ---------- */
  .weather-alerts {
    display: grid;
    margin: 0;
    padding: 0 32px 6px;
    list-style: none;
    gap: 10px;
  }

  .weather-alerts li {
    display: grid;
    align-items: center;
    padding: 12px 16px;
    border: 1px solid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    background: rgba(255, 255, 255, 0.7);
  }

  .weather-alerts li[data-severity="warning"] {
    border-color: rgba(198, 111, 72, 0.4);
    background: #fff3ef;
  }

  .weather-alerts li[data-severity="watch"] {
