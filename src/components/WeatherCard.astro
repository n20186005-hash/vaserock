<article class="weather-card" data-weather-card aria-labelledby="weather-title" aria-busy="true">
  <header class="weather-heading">
    <div>
      <h2 id="weather-title">今天的花瓶岩天氣</h2>
      <p class="weather-lead">固定查詢花瓶岩海岸周邊，提供目前天氣與三日預報。</p>
    </div>
    <p class="weather-updated" data-weather-updated aria-live="polite">正在取得最新資料…</p>
  </header>

  <div class="weather-shell">
    <div class="weather-loading" data-weather-loading>
      <span class="weather-loading-icon" aria-hidden="true"></span>
      <div>
        <strong>天氣資料載入中</strong>
        <p>正在連線至本站的天氣服務…</p>
      </div>
    </div>

    <div class="weather-content" data-weather-content hidden>
      <div class="weather-summary">
        <div class="weather-current">
          <span class="weather-icon" aria-hidden="true" data-weather-icon>🌤️</span>
          <div>
            <p class="weather-condition" data-weather-condition>--</p>
            <div class="weather-temperature">
              <strong data-weather-temperature>--°</strong>
              <span>體感 <b data-weather-apparent>--°</b></span>
            </div>
          </div>
        </div>

        <div class="weather-advice" data-weather-advice data-level="good">
          <span class="weather-advice-dot" aria-hidden="true"></span>
          <div>
            <strong data-weather-advice-title>取得行程提醒中</strong>
            <p data-weather-advice-text>請稍候。</p>
          </div>
        </div>
      </div>

      <dl class="weather-metrics">
        <div><dt>今日高／低</dt><dd data-weather-range>--°／--°</dd></div>
        <div><dt>最高降雨機率</dt><dd data-weather-rain>--%</dd></div>
        <div><dt>目前風速</dt><dd data-weather-wind>-- km/h</dd></div>
        <div><dt>今日最大陣風</dt><dd data-weather-gust>-- km/h</dd></div>
      </dl>

      <ul class="weather-days" data-weather-days aria-label="三日天氣預報"></ul>

      <footer class="weather-footer">
        <p>自動天氣預報不含即時海浪與潮位，海況及現場警示優先。</p>
        <p>
          資料來源：
          <a href="https://open-meteo.com/" target="_blank" rel="noopener" data-weather-source>
            Open-Meteo
          </a>
        </p>
      </footer>
    </div>

    <div class="weather-error" data-weather-error hidden>
      <span aria-hidden="true">
        <svg viewBox="0 0 32 32">
          <path d="M3 18c4-5 7 5 11 0s7 5 11 0 4 0 4 0"></path>
          <path d="M3 12c4-5 7 5 11 0s7 5 11 0 4 0 4 0"></path>
        </svg>
      </span>
      <div>
        <strong>暫時無法取得天氣資料</strong>
        <p>
          請稍後再試，或直接查看
          <a href="https://www.cwa.gov.tw/" target="_blank" rel="noopener">中央氣象署</a>。
        </p>
      </div>
    </div>
  </div>

  <a class="weather-more" href="/best-time/">
    查看最佳時間與天氣建議
    <span aria-hidden="true">→</span>
  </a>
</article>

<script>
  interface WeatherDay {
    label: string;
    icon: string;
    condition: string;
    maxTemperature: number;
    minTemperature: number;
    precipitationProbability: number;
  }

  interface WeatherResponse {
    updatedAt: string;
    current: {
      icon: string;
      condition: string;
      weatherCode: number;
      isDay: boolean;
      temperature: number;
      apparentTemperature: number;
      windSpeed: number;
    };
    today: {
      maxTemperature: number;
      minTemperature: number;
      precipitationProbability: number;
      maxWindGust: number;
    };
    daily: WeatherDay[];
    advice: {
      level: "good" | "watch" | "avoid";
      title: string;
      text: string;
    };
    source: {
      name: string;
      url: string;
    };
  }

  document.querySelectorAll<HTMLElement>("[data-weather-card]").forEach((card) => {
    const loading = card.querySelector("[data-weather-loading]");
    const content = card.querySelector("[data-weather-content]");
    const error = card.querySelector("[data-weather-error]");

    const setText = (selector: string, value: string) => {
      const element = card.querySelector(selector);
      if (element) element.textContent = value;
    };

    fetch("/api/weather", { headers: { Accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error("Weather request failed");
        return response.json();
      })
      .then((weather: WeatherResponse) => {
        setText("[data-weather-icon]", weather.current.icon);
        setText("[data-weather-temperature]", `${Math.round(weather.current.temperature)}°`);

        const thunder = [82, 95, 96, 99].includes(weather.current.weatherCode);
        setText(
          "[data-weather-condition]",
          `${weather.current.isDay !== false ? "日間" : "夜間"} · ${
            thunder ? "雷雨警示" : weather.current.condition
          }`
        );
        setText("[data-weather-apparent]", `${Math.round(weather.current.apparentTemperature)}°`);
        setText(
          "[data-weather-range]",
          `${Math.round(weather.today.maxTemperature)}°／${Math.round(weather.today.minTemperature)}°`
        );
        setText(
          "[data-weather-rain]",
          `${Math.round(weather.today.precipitationProbability)}%`
        );
        setText("[data-weather-wind]", `${Math.round(weather.current.windSpeed)} km/h`);
        setText("[data-weather-gust]", `${Math.round(weather.today.maxWindGust)} km/h`);
        setText("[data-weather-advice-title]", weather.advice.title);
        setText("[data-weather-advice-text]", weather.advice.text);

        const advice = card.querySelector("[data-weather-advice]");
        if (advice instanceof HTMLElement) advice.dataset.level = weather.advice.level;

        const updated = new Date(weather.updatedAt);
        setText(
          "[data-weather-updated]",
          `更新於 ${new Intl.DateTimeFormat("zh-TW", {
            month: "numeric",
            day: "numeric",
            hour: "2-digit",
            minute: "2-digit",
            hour12: false
          }).format(updated)}`
        );

        const source = card.querySelector("[data-weather-source]");
        if (source instanceof HTMLAnchorElement) {
          source.textContent = weather.source.name;
          source.href = weather.source.url;
        }

        const days = card.querySelector("[data-weather-days]");
        if (days instanceof HTMLUListElement) {
          days.replaceChildren(
            ...weather.daily.map((day) => {
              const item = document.createElement("li");
              const lead = document.createElement("div");
              const label = document.createElement("strong");
              const condition = document.createElement("span");
              const values = document.createElement("div");
              const temperatures = document.createElement("strong");
              const rain = document.createElement("span");

              label.textContent = day.label;
              condition.textContent = `${day.icon} ${day.condition}`;
              temperatures.textContent =
                `${Math.round(day.maxTemperature)}°／${Math.round(day.minTemperature)}°`;
              rain.textContent = `降雨 ${Math.round(day.precipitationProbability)}%`;
              lead.append(label, condition);
              values.append(temperatures, rain);
              item.append(lead, values);
              return item;
            })
          );
        }

        if (loading instanceof HTMLElement) loading.hidden = true;
        if (error instanceof HTMLElement) error.hidden = true;
        if (content instanceof HTMLElement) content.hidden = false;
        card.setAttribute("aria-busy", "false");
      })
      .catch(() => {
        if (loading instanceof HTMLElement) loading.hidden = true;
        if (content instanceof HTMLElement) content.hidden = true;
        if (error instanceof HTMLElement) error.hidden = false;
        setText("[data-weather-updated]", "資料暫時無法取得");
        card.setAttribute("aria-busy", "false");
      });
  });
</script>

<style is:global>
  .weather-section {
    padding-block: clamp(78px, 9vw, 132px);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(circle at 92% 12%, rgba(114, 184, 177, 0.18), transparent 31rem),
      var(--foam);
  }

  .weather-card {
    width: 100%;
  }

  .weather-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 36px;
  }

  .weather-heading > div {
    max-width: 760px;
  }

  .weather-heading h2 {
    margin: 0;
    font-size: clamp(2rem, 3.7vw, 3.8rem);
    font-weight: 670;
    letter-spacing: -0.055em;
    line-height: 1.06;
  }

  .weather-lead {
    max-width: 640px;
    margin: 18px 0 0;
    color: var(--muted);
    font-size: 1rem;
  }

  .weather-updated {
    flex: none;
    margin: 0;
    color: var(--muted);
    font-size: 0.74rem;
  }

  .weather-shell {
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.82);
    box-shadow: 0 28px 70px rgba(8, 44, 54, 0.1);
  }

  .weather-loading,
  .weather-error {
    display: flex;
    min-height: 220px;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 32px;
    color: var(--muted);
  }

  .weather-loading[hidden],
  .weather-error[hidden],
  .weather-content[hidden] {
    display: none;
  }

  .weather-loading strong,
  .weather-error strong {
    color: var(--ocean-deep);
    font-size: 0.95rem;
  }

  .weather-loading p,
  .weather-error p {
    margin: 3px 0 0;
    font-size: 0.8rem;
  }

  .weather-error > span {
    display: grid;
    width: 48px;
    height: 48px;
    flex: none;
    place-items: center;
    background: var(--warning-soft);
    color: var(--warning);
  }

  .weather-error svg {
    width: 27px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.7;
  }

  .weather-error a,
  .weather-footer a {
    color: var(--ocean);
    font-weight: 800;
  }

  .weather-loading-icon {
    width: 40px;
    height: 40px;
    border: 4px solid rgba(23, 121, 138, 0.14);
    border-top-color: var(--ocean);
    border-radius: 50%;
    animation: weather-spin 0.9s linear infinite;
  }

  @keyframes weather-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .weather-summary {
    display: grid;
    padding: 30px 32px 20px;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: stretch;
    gap: 18px;
  }

  .weather-current {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 18px;
  }

  .weather-icon {
    font-size: clamp(3.7rem, 7vw, 5.4rem);
    line-height: 1;
    filter: drop-shadow(0 7px 12px rgba(8, 44, 54, 0.12));
  }

  .weather-condition {
    margin: 0 0 2px;
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .weather-temperature {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .weather-temperature > strong {
    color: var(--ocean-deep);
    font-size: clamp(3.1rem, 6vw, 4.7rem);
    font-weight: 680;
    letter-spacing: -0.07em;
    line-height: 1;
  }

  .weather-temperature span {
    color: var(--muted);
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .weather-temperature b {
    color: var(--ocean-deep);
  }

  .weather-advice {
    display: grid;
    padding: 18px 20px;
    border: 1px solid rgba(23, 121, 138, 0.23);
    background: rgba(114, 184, 177, 0.1);
    grid-template-columns: 12px 1fr;
    align-items: center;
    gap: 14px;
  }

  .weather-advice-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--ocean);
    box-shadow: 0 0 0 5px rgba(23, 121, 138, 0.12);
  }

  .weather-advice strong {
    color: var(--ocean-deep);
    font-size: 0.95rem;
  }

  .weather-advice p {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .weather-advice[data-level="watch"] {
    border-color: rgba(194, 139, 48, 0.35);
    background: #fff8e8;
  }

  .weather-advice[data-level="watch"] .weather-advice-dot {
    background: #c28b30;
    box-shadow: 0 0 0 5px rgba(194, 139, 48, 0.14);
  }

  .weather-advice[data-level="avoid"] {
    border-color: rgba(198, 111, 72, 0.38);
    background: #fff3ef;
  }

  .weather-advice[data-level="avoid"] .weather-advice-dot {
    background: var(--warning);
    box-shadow: 0 0 0 5px rgba(198, 111, 72, 0.15);
  }

  .weather-metrics {
    display: grid;
    margin: 0;
    padding: 0 32px 26px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
  }

  .weather-metrics div {
    padding: 14px 15px;
    background: var(--sand);
  }

  .weather-metrics dt {
    color: var(--muted);
    font-size: 0.68rem;
  }

  .weather-metrics dd {
    margin: 3px 0 0;
    color: var(--ocean-deep);
    font-size: 0.94rem;
    font-weight: 750;
  }

  .weather-days {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
  }

  .weather-days li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 23px;
    border-right: 1px solid var(--line);
  }

  .weather-days li:last-child {
    border-right: 0;
  }

  .weather-days li > div {
    display: grid;
  }

  .weather-days li > div:last-child {
    text-align: right;
  }

  .weather-days strong {
    color: var(--ocean-deep);
    font-size: 0.84rem;
  }

  .weather-days span {
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.68rem;
  }

  .weather-days li > div:last-child span {
    color: var(--ocean);
    font-weight: 700;
  }

  .weather-footer {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 12px 23px;
    border-top: 1px solid var(--line);
    background: rgba(242, 237, 227, 0.58);
    color: var(--muted);
    font-size: 0.66rem;
  }

  .weather-footer p {
    margin: 0;
  }

  .weather-more {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
    padding-bottom: 3px;
    border-bottom: 1px solid var(--line);
    color: var(--ocean);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .weather-more:hover {
    color: var(--ocean-deep);
  }

  @media (max-width: 820px) {
    .weather-section {
      padding-block: 76px;
    }

    .weather-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 28px;
    }

    .weather-heading h2 {
      font-size: clamp(2.05rem, 9vw, 3.2rem);
    }

    .weather-summary {
      padding: 23px 20px 18px;
      grid-template-columns: 1fr;
    }

    .weather-current {
      gap: 13px;
    }

    .weather-icon {
      font-size: 3.5rem;
    }

    .weather-temperature > strong {
      font-size: 3.3rem;
    }

    .weather-metrics {
      padding: 0 20px 20px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .weather-days {
      grid-template-columns: 1fr;
    }

    .weather-days li {
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .weather-days li:last-child {
      border-bottom: 0;
    }

    .weather-footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
