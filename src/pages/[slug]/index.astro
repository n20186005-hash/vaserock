---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { guides, guideBySlug, type Guide } from "@/data/guides";
import {
  authoritativeSources,
  imageCredits,
  vaseRock
} from "@/data/site";

export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const path = `/${guide.slug}/`;
const relatedGuides = guide.related
  .map((slug) => guideBySlug[slug])
  .filter(Boolean);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: guide.title,
  description: guide.description,
  inLanguage: "zh-Hant-TW",
  mainEntityOfPage: `https://vaserock.com${path}`,
  image: `https://vaserock.com${guide.image}`,
  dateModified: guide.place || ["name-origin", "water-entry-guide"].includes(guide.slug) ? "2026-11-17" : "2026-07-27",
  author: {
    "@type": "Organization",
    name: "Vase Rock"
  },
  publisher: {
    "@type": "Organization",
    name: "Vase Rock",
    url: "https://vaserock.com"
  }
};

const faqSchema = guide.faq
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: guide.faq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: item.answer
        }
      }))
    }
  : null;

// 周邊景點各自有專屬位置，不把主站花瓶岩的座標套用到其他景點。
// 不填入未核對的評分、票價數值或 Google Place ID。
const attractionSchema = guide.place ? {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: guide.place.officialName,
  description: guide.description,
  image: (guide.gallery?.length ? guide.gallery : [{ src: guide.image }]).map((photo) => `https://vaserock.com${photo.src}`),
  address: guide.place.address,
  hasMap: guide.place.mapUrl,
  url: `https://vaserock.com${path}`
} : null;
---

<BaseLayout
  title={guide.seoTitle}
  description={guide.description}
  path={path}
  image={guide.place || guide.slug === "name-origin" || guide.slug === "water-entry-guide" ? guide.image : `/og/${guide.slug}.webp`}
  imageAlt={guide.imageAlt}
  type="article"
  breadcrumbs={[
    { name: "首頁", path: "/" },
    { name: guide.title, path }
  ]}
  schema={[articleSchema, ...(attractionSchema ? [attractionSchema] : []), ...(faqSchema ? [faqSchema] : [])]}
>
  <article class="guide">
    <header class="guide-hero">
      <div class="guide-hero-image">
        <img
          src={guide.image}
          alt={guide.imageAlt}
          width="1600"
          height="1067"
          fetchpriority="high"
          style={`object-position: ${guide.imagePosition ?? "center"};`}
        />
        <div class="image-index" aria-hidden="true">
          {guide.place ? <span>LIUQIU · PINGTUNG</span> : <><span>22°21′N</span><span>120°22′E</span></>}
        </div>
      </div>
      <div class="guide-hero-copy container">
        <nav class="breadcrumbs" aria-label="麵包屑">
          <a href="/">首頁</a>
          <span aria-hidden="true">/</span>
          <span>{guide.eyebrow}</span>
        </nav>
        <p class="eyebrow">{guide.eyebrow}</p>
        <h1>{guide.title}</h1>
        <p class="guide-lead">{guide.lead}</p>
        {guide.place && (
          <p class="guide-lead">{guide.place.hours} · {guide.place.admission} · <a href={guide.place.mapUrl} target="_blank" rel="noopener noreferrer">位置與最新 Google 評價 ↗</a></p>
        )}
        <div class="guide-actions">
          {guide.action ? (
            <a
              class="button button-primary"
              href={guide.action.href}
              target={guide.action.external ? "_blank" : undefined}
              rel={guide.action.external ? "noopener noreferrer" : undefined}
            >
              {guide.action.label}
              <span aria-hidden="true">{guide.action.external ? "↗" : "→"}</span>
            </a>
          ) : (
            <a class="button button-primary" href="#guide-content">
              開始閱讀
              <span aria-hidden="true">↓</span>
            </a>
          )}
          <a class="text-link" href="/safety/">先看安全提醒 <span>→</span></a>
        </div>
      </div>
    </header>

    <section class="guide-facts" aria-label="快速資訊">
      <div class="container fact-row">
        {guide.facts.map((fact, index) => (
          <div class="guide-fact">
            <span>0{index + 1}</span>
            <div>
              <p>{fact.label}</p>
              <strong>{fact.value}</strong>
            </div>
          </div>
        ))}
      </div>
    </section>

    {guide.place && (
      <section class="section container place-overview" aria-labelledby="place-manager-heading">
        <div class="place-manager-card">
          <p class="eyebrow">About · 景點管理與維護</p>
          <h2 id="place-manager-heading">{guide.place.managerTitle}</h2>
          <p>{guide.place.managerDescription}</p>
          <a class="text-link" href={guide.place.sourceUrl} target="_blank" rel="noopener noreferrer">主管機關與景點資料 ↗</a>
        </div>

        <div class="place-overview-intro">
          <p class="eyebrow">Explore · 景點概覽</p>
          <h2>走進{guide.place.officialName.split('（')[0]}</h2>
          <p>{guide.lead}</p>
          <h3>遊覽建議與觀察重點</h3>
          <ul class="place-bullet-list">
            {guide.place.highlights.slice(0, 2).map((point) => <li>{point}</li>)}
          </ul>
          <p>建議先依序安排：{guide.place.route.slice(0, 2).join(' → ')}。</p>
        </div>

        <div class="place-detail-card" id="place-basic-info">
          <p class="eyebrow">Visitor information</p>
          <h2>景點基本資料</h2>
          <dl class="place-detail-list">
            <div><dt>正式名稱</dt><dd>{guide.place.officialName}</dd></div>
            <div><dt>景點類型</dt><dd>{guide.place.type}</dd></div>
            <div><dt>地址</dt><dd>{guide.place.address}</dd></div>
            <div><dt>建議停留</dt><dd>{guide.place.visitDuration}</dd></div>
          </dl>
        </div>
        <div class="place-planning-grid">
          <div class="place-detail-card">
            <p class="eyebrow">Hours & admission</p>
            <h2>開放時間與門票價格</h2>
            <h3>開放時間</h3><p>{guide.place.hours}</p>
            <h3>門票及費用</h3><p>{guide.place.admission}</p>
            <p class="place-disclaimer">遇到天候、祭典、保育或臨時管制，請依景點現場公告安排參觀。</p>
          </div>
          <div class="place-detail-card">
            <p class="eyebrow">Getting here</p>
            <h2>交通方式與導航</h2>
            <p>{guide.place.arrival}</p>
            <p><strong>地址：</strong>{guide.place.address}</p>
            <a class="text-link" href={guide.place.mapUrl} target="_blank" rel="noopener noreferrer">開啟這處景點的 Google Maps ↗</a>
            <p class="place-disclaimer">導航連結使用本景點名稱；出發前請核對入口與可通行道路。</p>
          </div>
        </div>
      </section>
    )}

    {guide.slug === "map" && (
      <section class="map-feature section container" aria-labelledby="map-heading">
        <div class="map-embed">
          <iframe
            title="花瓶岩 Google Maps 地圖"
            src={`https://www.google.com/maps?q=${vaseRock.latitude},${vaseRock.longitude}&z=17&output=embed`}
            width="960"
            height="620"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
        <div class="map-control">
          <p class="eyebrow">Google Maps</p>
          <h2 id="map-heading">花瓶岩位置與導航</h2>
          <p>
            從白沙觀光港出發，建議選擇步行模式；騎車者請在允許停放處停妥後再前往海岸。
          </p>
          <div class="coordinate-box">
            <span>WGS84 座標</span>
            <strong>{vaseRock.coordinateLabel}</strong>
            <button type="button" data-copy={vaseRock.coordinateLabel}>複製座標</button>
          </div>
          <div class="map-buttons">
            <a href={vaseRock.walkingDirectionsUrl} target="_blank" rel="noopener noreferrer">
              步行導航 <span>↗</span>
            </a>
            <a href={vaseRock.drivingDirectionsUrl} target="_blank" rel="noopener noreferrer">
              騎車導航 <span>↗</span>
            </a>
          </div>
        </div>
      </section>
    )}

    <div id="guide-content" class="guide-content container">
      <aside class="guide-aside" aria-label="本頁內容">
        <p>本頁內容</p>
        <ol>
          {guide.sections.map((section, index) => (
            <li>
              <a href={`#section-${index + 1}`}>
                <span>0{index + 1}</span>
                {section.title}
              </a>
            </li>
          ))}
          {guide.faq && (
            <li>
              <a href="#frequent-questions">
                <span>0{guide.sections.length + 1}</span>
                常見問題
              </a>
            </li>
          )}
        </ol>
      </aside>

      <div class="guide-sections">
        {guide.sections.map((section, index) => (
          <section id={`section-${index + 1}`} class="guide-section">
            <div class="section-number">0{index + 1}</div>
            <div>
              {section.kicker && <p class="eyebrow">{section.kicker}</p>}
              <h2>{section.title}</h2>
              <p>{section.body}</p>
              {section.bullets && (
                <ul class="check-list">
                  {section.bullets.map((bullet) => (
                    <li>
                      <svg viewBox="0 0 20 20" aria-hidden="true">
                        <path d="m5 10 3 3 7-7"></path>
                      </svg>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
              {section.note && (
                <aside class="section-note">
                  <span aria-hidden="true">!</span>
                  <p>{section.note}</p>
                </aside>
              )}
            </div>
          </section>
        ))}

        {guide.faq && (
          <section id="frequent-questions" class="faq-section">
            <p class="eyebrow">FAQ</p>
            <h2>出發前常見問題</h2>
            <div class="faq-list">
              {guide.faq.map((item) => (
                <details>
                  <summary>
                    {item.question}
                    <span aria-hidden="true">＋</span>
                  </summary>
                  <p>{item.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        {guide.links && guide.links.length > 0 && (
          <section class="guide-links-section" aria-label="延伸閱讀">
            <p class="eyebrow">延伸閱讀</p>
            <h2>看完繼續看</h2>
            <p class="guide-links-lead">
              {guide.place ? "延伸至相關景點、主管機關資訊與島上順遊路線。" : "從潮汐理解、行程安排、浮潛安全到常見問題的完整閱讀順序。"}
            </p>
            <ul class="guide-links">
              {guide.links.map((link) => (
                <li>
                  <a href={link.href}>
                    <strong>{link.label}</strong>
                    {link.description && <p>{link.description}</p>}
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {guide.slug === "about" && (
          <>
            <section class="source-section" aria-labelledby="source-heading">
              <p class="eyebrow">Sources</p>
              <h2 id="source-heading">主要資料來源</h2>
              <p class="source-section-intro">
                評價 · 同步時間 <strong>{vaseRock.googleRating.syncedAt}</strong>。
                所有評分與評價數據同步自 Google 地圖使用者評價，
                同步時間 {vaseRock.googleRating.syncedAt}；版權歸原作者與 Google 地圖所有；
                本站僅作為引用展示，原始評論請至 Google 地圖查看。
              </p>
              <div class="source-list">
                {authoritativeSources.map((source, index) => (
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    <span>0{index + 1}</span>
                    <div>
                      <strong>{source.label}</strong>
                      <small>
                        {source.publisher}
                        {source.label.includes("Google") && (
                          <>
                            {" · 同步時間 "}{vaseRock.googleRating.syncedAt}
                          </>
                        )}
                      </small>
                    </div>
                    <b aria-hidden="true">↗</b>
                  </a>
                ))}
              </div>
              <p class="source-section-foot">
                <strong>評分與評價數同步自 Google Maps · {vaseRock.googleRating.syncedAt} ·</strong>
                <a
                  href={vaseRock.reviewsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="source-reviews-link"
                >
                  點擊查看 Google 地圖全部評價 ↗
                </a>
              </p>
            </section>

            <section class="credit-section" aria-labelledby="credit-heading">
              <p class="eyebrow">Photography</p>
              <h2 id="credit-heading">實景圖片授權</h2>
              <p class="credit-intro">
                <strong>圖片版權：</strong>本網站所展示的所有圖片，其著作權及版權均歸原攝影者所有；本站僅依各檔案的原始授權條款（CC BY、CC BY-SA、CC0 等）使用，並依網站版位調整尺寸，部分圖片經裁切。
              </p>
              <div class="credit-list">
                {imageCredits.map((credit) => (
                  <a href={credit.source} target="_blank" rel="noopener noreferrer">
                    <span>{credit.file}</span>
                    <strong>{credit.title}</strong>
                    <small>{credit.author} · {credit.license}</small>
                  </a>
                ))}
              </div>
            </section>
          </>
        )}
      </div>
    </div>

    {guide.place && (
      <section class="section container place-more-detail" aria-labelledby="place-highlights-heading">
        <p class="eyebrow">Explore the place</p>
        <h2 id="place-highlights-heading">發現這處景點的魅力</h2>
        <ol class="place-numbered-list">
          {guide.place.highlights.map((item) => <li>{item}</li>)}
        </ol>
        <h2>推薦遊覽路線</h2>
        <ol class="place-numbered-list">
          {guide.place.route.map((step) => <li>{step}</li>)}
        </ol>
        <h2>遊覽須知</h2>
        <ul class="place-bullet-list">{guide.place.etiquette.map((item) => <li>{item}</li>)}</ul>
        <h2>拍照機位與構圖</h2>
        <ol class="place-numbered-list">{guide.place.photoSpots.map((item) => <li>{item}</li>)}</ol>
        <h2>住宿與行程建議</h2><p>{guide.place.accommodation}</p>
        <h2>遊客評價與更新</h2><p>{guide.place.ratingNote}</p>
        <p><a class="text-link" href={guide.place.mapUrl} target="_blank" rel="noopener noreferrer">查看 Google Maps 評價 ↗</a></p>
        <h2>交通與地圖</h2><p>{guide.place.address}</p>
        <p>{guide.place.arrival}</p>
        <a class="button button-primary" href={guide.place.mapUrl} target="_blank" rel="noopener noreferrer">開啟景點地圖 ↗</a>
      </section>
    )}

    {guide.gallery && (
      <section class="section container" aria-labelledby="place-gallery-heading">
        <p class="eyebrow">Photography</p>
        <h2 id="place-gallery-heading">景點實景照片</h2>
        {guide.gallery.map((photo) => (
          <figure>
            <img src={photo.src} alt={photo.alt} loading="lazy" width="1200" height="800" style="max-width:100%;height:auto;border-radius:1rem;" />
            <figcaption>{photo.alt}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <section class="related section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Next guide</p>
            <h2>下一步，接著準備</h2>
          </div>
          <a class="text-link" href="/faq/">查看常見問題 <span>→</span></a>
        </div>
        <div class="related-grid">
          {relatedGuides.map((related, index) => (
            <a class="related-card" href={`/${related.slug}/`}>
              <span>0{index + 1}</span>
              <p>{related.eyebrow}</p>
              <h3>{related.title}</h3>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>
