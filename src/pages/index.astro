---
import BaseLayout from "@/layouts/BaseLayout.astro";
import WeatherCard from "@/components/WeatherCard.astro";
import TideCard from "@/components/TideCard.astro";
import GoogleReviewsBlock from "@/components/GoogleReviewsBlock.astro";
import SeasonalStrategy from "@/components/SeasonalStrategy.astro";
import VisitorServices from "@/components/VisitorServices.astro";
import ProfileItineraries from "@/components/ProfileItineraries.astro";
import GeneralItineraries from "@/components/GeneralItineraries.astro";
import VisitorEtiquette from "@/components/VisitorEtiquette.astro";
import HistoryFolklore from "@/components/HistoryFolklore.astro";
import { vaseRock } from "@/data/site";
import { fetchWeather } from "@/data/weather";

const homeFaq = [
  {
    question: "花瓶岩在哪裡？",
    answer: "花瓶岩位於屏東縣琉球鄉北側海岸，距白沙觀光港約 300 公尺。"
  },
  {
    question: "花瓶岩需要門票嗎？",
    answer: "景點本體免費參觀，戶外海岸環境仍會受天候、海況或臨時管制影響。"
  },
  {
    question: "花瓶岩建議停留多久？",
    answer: "一般觀景與拍照約 20 至 40 分鐘；想細看地質、光線或潮位可安排約 1 小時。"
  },
  {
    question: "花瓶岩可以浮潛嗎？",
    answer: "周邊是熱門浮潛水域，但須依當日海況判斷；初學者請由合格教練帶領。"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  }))
};

// Server-side 抓取天氣（build time SSR），給 WeatherCard 作為初始資料。
// 若上游失敗或沒有網路，仍可優雅降級；前端腳本會再從 /api/weather 重新抓取。
let initialWeather = null;
try {
  initialWeather = await fetchWeather({
    latitude: vaseRock.latitude,
    longitude: vaseRock.longitude,
    locationLabel: vaseRock.fullName
  });
} catch (error) {
  console.warn(
    JSON.stringify({
      message: "build-time weather fetch failed",
      error: error instanceof Error ? error.message : String(error)
    })
  );
}
---

<BaseLayout
  path="/"
  title="小琉球花瓶岩（花瓶石）攻略｜交通、潮汐與拍照 - Vase Rock"
  description="花瓶岩（又稱花瓶石，Vase Rock）是小琉球代表性地標，位於白沙觀光港附近。整理交通路線、拍照時段、潮位、浮潛與安全提醒，出發前快速掌握。"
  schema={faqSchema}
  image="/og/homepage.webp"
  imageAlt="花瓶岩（Vase Rock）海岸全景——屏東縣琉球鄉白沙觀光港旁"
>
  <!-- 首屏 Hero：H1 全页唯一，包含全称与城市 -->
  <section class="home-hero">
    <img
      class="home-hero-image"
      src="/images/vase-rock-hero.webp"
      alt="花瓶岩（Vase Rock）主視覺——屏東縣琉球鄉海岸上的珊瑚礁岩，前景是珊瑚礁碎石與海浪"
      width="1920"
      height="1440"
      fetchpriority="high"
    />
    <div class="home-hero-shade"></div>
    <div class="home-hero-grid container">
      <div class="hero-copy">
        <p class="hero-kicker">
          <span>22°21′N · 120°22′E</span>
          <span>LIUQIU · PINGTUNG</span>
        </p>
        <!-- H1：花瓶岩（琉球鄉）— 实体全称 + 城市绑定 -->
        <h1>花瓶岩<br />琉球鄉<span>旅遊指南</span></h1>
        <p class="hero-summary">
          歡迎來到 <strong>花瓶岩（又稱花瓶石，Vase Rock）</strong>，小琉球最具辨識度的自然地標。
          位於琉球鄉、屏東縣、臺灣核心位置，是旅客規劃小琉球的起點。
        </p>
        <p class="hero-entity-line">
          花瓶岩（Vase Rock） → 琉球鄉 → 屏東縣 → 臺灣
        </p>
        <div class="hero-actions">
          <a
            class="button button-white"
            href={vaseRock.placeUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="map_open"
          >
            在 Google Maps 開始導航
            <span aria-hidden="true">↗</span>
          </a>
          <a class="hero-secondary" href="/from-baisha-port/">
            從白沙港怎麼走
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="hero-side" aria-label="快速資訊">
        <div class="hero-weather-note">
          <span class="pulse-dot"></span>
          <p>海岸行程提醒</p>
          <strong>先看潮汐，再看現場浪況</strong>
          <a href="/tide-guide/">查看潮汐判讀 <span>→</span></a>
        </div>
        <div class="hero-index">
          <span>01</span>
          <div></div>
          <p>VASE ROCK<br />TRAVEL FIELD GUIDE</p>
        </div>
      </div>
    </div>
    <div class="hero-tags container" aria-label="景點特色">
      <span>免費參觀</span>
      <span>鄰近白沙港</span>
      <span>珊瑚礁地景</span>
      <span>適合攝影</span>
      <span class="tag-warning">礁石濕滑</span>
    </div>
  </section>

  <section class="quick-facts" aria-labelledby="quick-heading">
    <div class="container">
      <div class="quick-title">
        <p class="eyebrow">At a glance</p>
        <h2 id="quick-heading">第一次去花瓶岩，先知道這五件事</h2>
      </div>
      <div class="quick-grid">
        <div class="quick-item">
          <span>01</span>
          <svg viewBox="0 0 28 28" aria-hidden="true">
            <path d="M14 25s7-6 7-13a7 7 0 1 0-14 0c0 7 7 13 7 13Z"></path>
            <circle cx="14" cy="12" r="2.5"></circle>
          </svg>
          <p>地點</p>
          <strong>屏東縣琉球鄉</strong>
        </div>
        <div class="quick-item">
          <span>02</span>
          <svg viewBox="0 0 28 28" aria-hidden="true">
            <path d="M4 20h20M7 20V9l7-4 7 4v11M11 20v-6h6v6"></path>
          </svg>
          <p>距白沙港</p>
          <strong>約 300 公尺</strong>
        </div>
        <div class="quick-item">
          <span>03</span>
          <svg viewBox="0 0 28 28" aria-hidden="true">
            <circle cx="14" cy="14" r="10"></circle>
            <path d="M9 14h10M14 9v10"></path>
          </svg>
          <p>參觀費用</p>
          <strong>景點本體免費</strong>
        </div>
        <div class="quick-item">
          <span>04</span>
          <svg viewBox="0 0 28 28" aria-hidden="true">
            <circle cx="14" cy="14" r="10"></circle>
            <path d="M14 8v6l4 2"></path>
          </svg>
          <p>建議停留</p>
          <strong>20–40 分鐘</strong>
        </div>
        <div class="quick-item">
          <span>05</span>
          <svg viewBox="0 0 28 28" aria-hidden="true">
            <path d="M4 18c3-5 5 5 8 0s5 5 8 0 4 0 4 0"></path>
            <path d="M4 12c3-5 5 5 8 0s5 5 8 0 4 0 4 0"></path>
          </svg>
          <p>適合活動</p>
          <strong>觀景、拍照、浮潛</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="weather-section">
    <div class="container">
      <WeatherCard initialData={initialWeather} />
    </div>
  </section>

  <section class="tide-section">
    <div class="container">
      <TideCard />
    </div>
  </section>

  <section class="intent section container" aria-labelledby="intent-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Choose your route</p>
        <h2 id="intent-heading">這次，你想怎麼看花瓶岩？</h2>
      </div>
      <p class="section-intro">從需求開始，比照著景點清單走更快。</p>
    </div>
    <div class="intent-grid">
      <a class="intent-card featured" href="/from-baisha-port/">
        <img
          src="/images/baisha-port.webp"
          alt="白沙觀光港——花瓶岩最近的港口節點，停泊客輪與漁船的小琉球主要港口"
          width="760"
          height="570"
          loading="lazy"
        />
        <div class="intent-overlay"></div>
        <span>01 · 第一次到訪</span>
        <div>
          <h3>下船後，<br />直接走過去。</h3>
          <p>從港口怎麼走、停留多久、回程怎麼抓。</p>
        </div>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="intent-card photo" href="/photo-guide/">
        <span>02 · 想拍好照片</span>
        <h3>讓光線決定角度，<br />不用更靠近。</h3>
        <p>比較清晨、日間與傍晚的構圖方法。</p>
        <div class="intent-mini-image">
          <img
            src="/images/vase-rock-water.webp"
            alt="花瓶岩日間海水環繞——陽光下海水層次與瓶頸線條清晰可見"
            width="500"
            height="334"
            loading="lazy"
          />
        </div>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="intent-card dark" href="/snorkeling/">
        <span>03 · 想下水浮潛</span>
        <h3>海況對了，<br />才是下水時間。</h3>
        <p>裝備、初學者判斷與海龜觀察守則。</p>
        <svg viewBox="0 0 220 100" aria-hidden="true">
          <path d="M0 62c27-20 48 17 75-3s49 18 76-3 44 4 69-10"></path>
          <path d="M0 82c27-20 48 17 75-3s49 18 76-3 44 4 69-10"></path>
        </svg>
        <b aria-hidden="true">↗</b>
      </a>
      <a class="intent-card time" href="/itinerary/">
        <span>04 · 只有一小時</span>
        <div class="time-display">
          <strong>60</strong><small>MIN</small>
        </div>
        <h3>看完地標，<br />準時回港。</h3>
        <p>30 分鐘、1 小時與半日行程。</p>
        <b aria-hidden="true">↗</b>
      </a>
    </div>
  </section>

  <!-- About 花瓶岩（H2 实体绑定：包含全称与城市） -->
  <section class="about-rock section container" aria-labelledby="about-rock-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">About Vase Rock</p>
        <h2 id="about-rock-heading">關於花瓶岩（琉球鄉）</h2>
      </div>
    </div>
    <div class="about-rock-grid">
      <div class="about-rock-copy">
        <p>
          <strong>花瓶岩（Vase Rock）</strong>是位於琉球鄉北側海岸的隆起珊瑚礁岩，
          因形似花瓶而得名，是小琉球最具辨識度的中央地標。
          座標約為 22.3556469°N、120.3807532°E，
          距離<strong>白沙觀光港</strong>約 300 公尺，旅客下船後步行即可抵達。
        </p>
        <p>
          造訪花瓶岩（Vase Rock）時，周邊可順遊的核心地標包含
          <strong>白沙觀光港</strong>與<strong>中澳沙灘</strong>；
          不論是剛下船的快速拍照，或排入半日海岸環線，都能以花瓶岩為起點規劃。
        </p>
      </div>
      <aside class="about-rock-meta">
        <span>景點資料</span>
        <dl>
          <div>
            <dt>全稱</dt>
            <dd>花瓶岩（Vase Rock）</dd>
          </div>
          <div>
            <dt>所在</dt>
            <dd>琉球鄉 · 屏東縣 · 臺灣</dd>
          </div>
          <div>
            <dt>郵編</dt>
            <dd>929</dd>
          </div>
          <div>
            <dt>免費</dt>
            <dd>景點本體免費參觀</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- Location & How to Visit（H2：包含简称与城市） -->
  <section class="map-home section" aria-labelledby="map-home-heading">
    <div class="container map-home-grid">
      <div class="map-home-copy">
        <p class="eyebrow light">03 · Location</p>
        <h2 id="map-home-heading">花瓶岩在琉球鄉的位置與導航</h2>
        <p>
          花瓶岩（Vase Rock）距白沙觀光港約 300 公尺。一般步行約 5–10 分鐘；
          帶著行李、親子同行或遇到港區人流時，請多留緩衝。
        </p>
        <div class="map-route">
          <div>
            <span>START</span>
            <strong>白沙觀光港</strong>
          </div>
          <div class="route-line">
            <span>約 300 m</span>
          </div>
          <div>
            <span>ARRIVE</span>
            <strong>花瓶岩海岸</strong>
          </div>
        </div>
        <div class="map-home-actions">
          <a
            class="button button-light"
            href={vaseRock.walkingDirectionsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            開始步行導航 <span>↗</span>
          </a>
          <a class="text-link light" href="/from-baisha-port/">
            查看完整路線 <span>→</span>
          </a>
        </div>
      </div>
      <div class="map-visual map-embed-home">
        <iframe
          title="花瓶岩 Google Maps 地圖——琉球鄉北側海岸位置"
          src={vaseRock.mapsEmbedSrc}
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
        <div class="map-coordinates">
          <span>WGS84</span>
          <strong>{vaseRock.coordinateLabel}</strong>
          <button type="button" data-copy={vaseRock.coordinateLabel}>複製</button>
        </div>
      </div>
    </div>
  </section>

  <!-- 评价区块：Google Maps 用户评价同步展示，注明来源 -->
  <GoogleReviewsBlock />

  <!-- History & Folklore：历史背景与在地传说 -->
  <HistoryFolklore />

  <!-- Tide 潮位（H2：包含全称与城市） -->
  <section class="tide-home section container" aria-labelledby="tide-heading">
    <div class="section-heading tide-title">
      <div>
        <p class="eyebrow">Read the tide</p>
        <h2 id="tide-heading">花瓶岩同一座岩，三種海岸表情。</h2>
      </div>
      <div>
        <p class="section-intro">潮位改變畫面，也改變可以安全停留的位置。</p>
        <a class="text-link" href="/tide-guide/">完整潮汐指南 <span>→</span></a>
      </div>
    </div>
    <div class="tide-grid">
      <article class="tide-card">
        <div class="tide-level low" aria-hidden="true">
          <span>LOWER</span>
          <svg viewBox="0 0 400 170"><path d="M0 122c60-20 91 17 151-3s91 18 151-3 98 3 98 3V170H0Z"></path></svg>
        </div>
        <span class="tide-number">01</span>
        <h3>較低潮位</h3>
        <p>礁台與潮池露出較多，適合從安全位置觀察潮間帶；露出的礁面仍可能濕滑。</p>
      </article>
      <article class="tide-card active">
        <div class="tide-level mid" aria-hidden="true">
          <span>MIDDLE</span>
          <svg viewBox="0 0 400 170"><path d="M0 88c60-20 91 17 151-3s91 18 151-3 98 3 98 3V170H0Z"></path></svg>
        </div>
        <span class="tide-number">02</span>
        <h3>中間潮位</h3>
        <p>海水與岩體比例均衡，適合一般拍照；先觀察浪組，再決定站立位置。</p>
      </article>
      <article class="tide-card">
        <div class="tide-level high" aria-hidden="true">
          <span>HIGHER</span>
          <svg viewBox="0 0 400 170"><path d="M0 49c60-20 91 17 151-3s91 18 151-3 98 3 98 3V170H0Z"></path></svg>
        </div>
        <span class="tide-number">03</span>
        <h3>較高潮位</h3>
        <p>海水包圍岩體的畫面更完整，可活動空間變少；保持遠距，不冒險涉水。</p>
      </article>
    </div>
    <div class="tide-source">
      <span class="pulse-dot dark"></span>
      <p>查詢當日潮汐與沿海預報</p>
      <a
        href="https://www.cwa.gov.tw/V8/C/M/tide.html"
        target="_blank"
        rel="noopener noreferrer"
      >
        中央氣象署潮汐預報 <span>↗</span>
      </a>
    </div>
  </section>

  <!-- Photography 拍照指南（H2） -->
  <section class="photo-home section" aria-labelledby="photo-heading">
    <div class="photo-collage container">
      <div class="photo-main">
        <img
          src="/images/vase-rock-water.webp"
          alt="花瓶岩日間拍攝——陽光照亮岩體與青綠色海面，呈現標準構圖視角"
          width="1200"
          height="801"
          loading="lazy"
        />
        <span>DAYLIGHT · CLEAR WATER</span>
      </div>
      <div class="photo-copy">
        <p class="eyebrow light">04 · Photography</p>
        <h2 id="photo-heading">花瓶岩拍照指南：<br />拍得好，不需要站得近。</h2>
        <p>
          先選穩定落腳處，再用焦段、人物比例與留白整理畫面。
          海況不適合時，一張遠景就是最好的決定。
        </p>
        <a class="button button-outline-light" href="/photo-guide/">
          查看完整拍照指南 <span>→</span>
        </a>
        <div class="photo-notes">
          <div>
            <span>01</span>
            <strong>清晨</strong>
            <p>柔和光線、安靜構圖</p>
          </div>
          <div>
            <span>02</span>
            <strong>日間</strong>
            <p>海水層次、手機旅行照</p>
          </div>
          <div>
            <span>03</span>
            <strong>傍晚</strong>
            <p>暖色輪廓、留意回程</p>
          </div>
        </div>
      </div>
      <div class="photo-detail">
        <img
          src="/images/vase-rock-geology.webp"
          alt="花瓶岩珊瑚礁石灰岩細節——近看岩體粗糙多孔的紋理"
          width="620"
          height="465"
          loading="lazy"
        />
        <span>CORAL LIMESTONE · DETAIL</span>
      </div>
    </div>
  </section>

  <!-- Safety 安全提醒（H2） -->
  <section class="safety-home section" aria-labelledby="safety-heading">
    <div class="container safety-grid">
      <div class="safety-intro">
        <p class="eyebrow">Keep the distance</p>
        <h2 id="safety-heading">花瓶岩安全提醒：<br />保護自己，也讓地景繼續存在。</h2>
        <p>
          花瓶岩（Vase Rock）頸部持續受侵蝕。保持距離、遠觀不攀爬，
          是最簡單也最重要的旅行選擇。
        </p>
        <a class="text-link" href="/safety/">完整安全指南 <span>→</span></a>
      </div>
      <div class="safety-list">
        {[
          ["01", "不攀爬花瓶岩", "岩體持續受侵蝕，遠觀即可。"],
          ["02", "不踩踏活珊瑚", "潮池與礁面都是生物棲地。"],
          ["03", "不追逐、觸摸海龜", "讓野生動物保有換氣與離開空間。"],
          ["04", "海況不佳不下水", "潮汐表不能取代現場判斷。"],
          ["05", "穿包覆式防滑鞋", "拖鞋與赤腳不適合尖銳礁面。"]
        ].map((item) => (
          <div>
            <span>{item[0]}</span>
            <strong>{item[1]}</strong>
            <p>{item[2]}</p>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 3 4 6v5c0 5 3.4 8.4 8 10 4.6-1.6 8-5 8-10V6l-8-3Z"></path>
            </svg>
          </div>
        ))}
      </div>
    </div>
  </section>

